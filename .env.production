# Variables de build pour la PRODUCTION (chargées par `astro build`).
#
# Le vrai déploiement est Cloudflare (Worker `mixt-landing`, build Git-connecté
# qui tourne `npm run build` à chaque push sur master). Astro n'injecte les
# variables PUBLIC_* qu'AU MOMENT DU BUILD : elles doivent donc être présentes
# dans l'environnement du build Cloudflare. On les versionne ici parce qu'elles
# sont PUBLIQUES par nature (elles finissent dans le JS client, visibles dans les
# requêtes réseau). Aucune valeur secrète ne doit jamais aller dans ce fichier.
#
# Pour surcharger sans commit : définir ces mêmes clés en "Build variables" du
# projet Cloudflare (Settings > Build) — l'env process a priorité sur ce fichier.
PUBLIC_POSTHOG_KEY=phc_twuVQ9f6zfZzS2VqGiztMnLYbmXB2AuWfhJVc5t8wPEJ
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_META_PIXEL_ID=1353550740223559
