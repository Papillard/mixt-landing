# fal.ai API key for the on-brand image generation CLI
# Get yours at https://fal.ai/dashboard/keys
# This file is committed as a template. Copy it to .env and paste your key there.
FAL_API_KEY=

# Analytics (chargés uniquement après consentement cookies).
# Les 3 valeurs sont publiques (elles finissent dans le JS client). Astro
# n'injecte côté client QUE les variables préfixées PUBLIC_.
# PostHog "Project API Key" (phc_...), PAS la Personal API Key (phx_, secrète).
PUBLIC_POSTHOG_KEY=
# Host d'ingestion PostHog (projet EU par défaut).
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Meta Pixel : identifiant numérique du pixel (Events Manager).
PUBLIC_META_PIXEL_ID=
