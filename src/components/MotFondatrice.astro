---
// Mot de la fondatrice : remplace l'ancien bloc « Avant-première » (obsolète).
// Histoire reprise de la pub CP42 (« 10 ans de taches »). Titre explicite pour qu'on comprenne d'emblée qui parle.
import FadeInSection from './motion/FadeInSection.tsx';
import Button from './Button.astro';

interface Props {
  ctaHref: string;
  ctaLabel: string;
  bg?: string;
}
const { ctaHref, ctaLabel, bg = 'bg-cream' } = Astro.props;
---

<section class={`px-6 md:px-10 py-24 md:py-32 ${bg}`}>
  <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-10 md:gap-16 items-center">
    <FadeInSection client:load y={20}>
      <figure class="m-0 relative">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-blush/30">
          <img
            src="/images/real/fondatrice-laetitia-payan-selfie-01.webp"
            alt="Laetitia Payan, fondatrice de Mixt"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-[center_30%]"
          />
        </div>
        <figcaption class="absolute left-3 bottom-3 rounded-xl bg-white px-4 py-2.5">
          <div class="text-[15px] font-semibold text-ink leading-tight">Laetitia Payan</div>
          <div class="text-[12.5px] text-ink-2">Fondatrice de Mixt</div>
        </figcaption>
      </figure>
    </FadeInSection>
    <FadeInSection client:load delay={0.1}>
      <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-5">
        Le mot de la fondatrice
      </div>
      <h2 class="text-balance text-[34px] md:text-[48px] font-bold leading-[1.05] tracking-[-0.035em] text-ink mb-7">
        Pourquoi j'ai créé Mixt
      </h2>
      <p class="text-[17px] md:text-[19px] leading-[1.6] text-ink mb-4 max-w-[540px]">
        Mon masque de grossesse a duré dix ans. Dix ans de crèmes au hasard, sans vrai suivi médical.
      </p>
      <p class="text-[16px] md:text-[17px] leading-[1.65] text-ink-2 mb-8 max-w-[540px]">
        J'ai créé Mixt pour que chaque personne ait accès à des médecins et à une dermatologue qui construisent un traitement fondé sur la science, et le suivent dans la durée.
      </p>
      <Button href={ctaHref} variant="ember-pill">{ctaLabel} →</Button>
    </FadeInSection>
  </div>
</section>
