---
// CTA collé en bas d'écran, mobile uniquement : la consultation reste à portée de pouce.
const href = 'https://app.mixt.care/start';
---

<div
  class="lg:hidden fixed inset-x-0 bottom-0 z-40 bg-white border-t border-black/[0.08] px-4 pt-3"
  style="padding-bottom: calc(10px + env(safe-area-inset-bottom));"
>
  <a
    href={href}
    data-sticky-cta
    class="flex w-full items-center justify-center gap-2 rounded-full bg-ember border border-ember px-6 py-[14px] text-[16px] font-semibold text-white no-underline shadow-[0_2px_14px_-2px_rgba(240,80,42,0.35)] active:bg-ember-dark"
  >
    Démarrer ma consultation →
  </a>
  <p class="mt-1.5 text-center text-[12px] text-ink-3 leading-tight">Bilan gratuit, puis consultation à 49 €</p>
</div>
{/* Réserve la place du CTA pour que le footer ne soit pas masqué */}
<div class="lg:hidden h-[96px]" aria-hidden="true"></div>

<script>
  // iOS (Safari et Chrome, même moteur) : pendant un défilement inertiel, le premier tap sert
  // à stopper le scroll. Le navigateur n'émet alors ni « click » ni même « touchend » :
  // il envoie « touchcancel ». On traite donc touchend ET touchcancel comme un tap,
  // tant que le doigt n'a quasiment pas bougé (un swipe reste ignoré).
  const link = document.querySelector<HTMLAnchorElement>('[data-sticky-cta]');
  if (link) {
    let x0 = 0, y0 = 0, x = 0, y = 0, t = 0, active = false, fired = false;
    const go = () => {
      if (fired) return;
      fired = true;
      link.click(); // navigation + autocapture PostHog
      setTimeout(() => { fired = false; }, 1500);
    };
    const isTap = () => Math.abs(x - x0) < 12 && Math.abs(y - y0) < 12 && Date.now() - t < 900;
    link.addEventListener('touchstart', (e) => {
      const p = e.touches[0];
      x0 = x = p.clientX; y0 = y = p.clientY; t = Date.now(); active = true;
    }, { passive: true });
    link.addEventListener('touchmove', (e) => {
      const p = e.touches[0]; x = p.clientX; y = p.clientY;
    }, { passive: true });
    link.addEventListener('touchend', (e) => {
      if (!active) return; active = false;
      if (!isTap()) return;
      e.preventDefault(); // évite le clic natif en double
      go();
    });
    link.addEventListener('touchcancel', () => {
      if (!active) return; active = false;
      if (isTap()) go();
    });
    // Filet de sécurité : si le clic natif arrive quand même juste après, on ne navigue pas deux fois.
    link.addEventListener('click', (e) => { if (fired && e.isTrusted) e.preventDefault(); });
  }
</script>
