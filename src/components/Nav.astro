---
interface Props {
  ctaHref?: string;
  ctaLabel?: string;
  homeHref?: string;
}

const {
  ctaHref = 'https://app.mixt.care/start',
  ctaLabel = 'Rejoindre',
  homeHref = '/',
} = Astro.props;

const conditions = [
  { href: '/melasma/', label: 'Mélasma', teaser: 'Masque de grossesse, taches hormonales' },
  { href: '/hyperpigmentation/', label: 'Hyperpigmentation', teaser: "Taches brunes, taches solaires, marques d'acné" },
  { href: '/rosacee/', label: 'Rosacée', teaser: 'Rougeurs diffuses, sensations de chaleur' },
  { href: '/acne/', label: 'Acné', teaser: 'Boutons, points noirs, marques' },
];
---

<nav class="fixed top-0 left-0 right-0 z-[100] h-14 px-10 flex items-center justify-between bg-base border-b border-black/[0.06]">
  <a
    href={homeHref}
    class="flex items-baseline gap-2.5 no-underline transition-colors"
    aria-label="Mixt, accueil"
  >
    <span class="font-serif text-[26px] font-bold text-ink leading-none tracking-[-0.045em]">mixt</span>
    <span class="hidden sm:inline font-mono text-[9.5px] uppercase tracking-[0.14em] text-ink-2 leading-none pb-[1px]">Dermatologie sur ordonnance</span>
  </a>

  <div class="flex items-center gap-1 md:gap-3">
    {/* Conditions dropdown masqué : pages concerns obsolètes, à réactiver une fois à jour */}

    <a
      href="https://app.mixt.care/login"
      class="hidden md:inline-flex items-center whitespace-nowrap px-3 py-2 text-[14px] font-medium text-ink/70 no-underline transition-colors hover:text-ink"
    >
      Se connecter
    </a>

    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 whitespace-nowrap px-5 md:px-6 py-2.5 text-[14px] font-semibold rounded-full bg-ember text-white no-underline transition-colors hover:bg-ember-dark shadow-[0_2px_14px_-2px_rgba(240,80,42,0.35)]"
    >
      {ctaLabel}
    </a>
  </div>
</nav>

<style>
  @media (max-width: 720px) {
    nav {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
