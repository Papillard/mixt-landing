---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import Accordion from '../motion/Accordion.tsx';
import FadeInSection from '../motion/FadeInSection.tsx';
import BeforeAfterReveal from '../motion/BeforeAfterReveal.tsx';
import ProgressCurve from '../motion/ProgressCurve.tsx';
import PhotoSlot from './PhotoSlot.astro';
import PrescriptionLabel from './PrescriptionLabel.astro';
import type { Concern } from '../../data/concerns/types';

interface Props {
  concern: Concern;
}

const { concern } = Astro.props;

// CTA concern-aware : on transporte le concern jusqu'à la waitlist pour pré-remplir
// le message WhatsApp / l'email et garder la continuité d'intention.
const CTA_HREF = 'https://app.mixt.care/start';
const CTA_LABEL = 'Démarrer mon bilan gratuit';
const CTA_NAV = 'Bilan gratuit';
// Transparence prix directement sous le bouton : le patron commun aux trois
// benchmarks (Skin+Me, Formel Skin, Skin&Out). Tue l'objection avant qu'elle naisse.
const CTA_NOTE = 'Gratuit, 5 minutes. Consultation ensuite à 49 €, reversés intégralement au médecin.';

// Jeu d'icônes minimal (tracés Lucide, stroke 1.5), inline pour éviter une dépendance.
const icons: Record<string, string> = {
  fileText:
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  stethoscope:
    '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  calendarCheck:
    '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  badgeCheck:
    '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>',
  shieldCheck:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};

// Bandeau de réassurance du hero : vitesse, expertise, absence de risque.
// Ce sont les trois signaux qui décident sur du trafic publicitaire.
const trust = Astro.props.concern.trust ?? [
  { icon: 'calendarCheck', label: 'Consultation sous 7 jours' },
  { icon: 'stethoscope', label: 'Médecin expert' },
  { icon: 'shieldCheck', label: 'Bilan gratuit, sans engagement' },
];

// Parcours, identique pour chaque concern. Les trois visuels montrent le
// service en train de fonctionner, pas la condition : ils sont donc partagés.
const steps = [
  {
    number: '01',
    icon: 'fileText',
    tag: 'Gratuit · 5 minutes',
    title: 'Votre dossier en ligne',
    body: "Construit en quelques minutes avec notre assistant. Vos antécédents, vos photos, ce que vous avez déjà essayé : tout est prêt pour votre médecin.",
    image: null,
    imageBrief: 'Photos guidées au miroir',
    imageDesc: "Femme face au miroir de sa salle de bain, téléphone en main, prenant sa photo de face. Lumière du jour, sujet décalé dans le cadre.",
  },
  {
    number: '02',
    icon: 'stethoscope',
    tag: 'Sous 7 jours',
    title: 'Votre consultation',
    body: 'Une consultation en ligne avec un médecin expert de votre peau, supervisé par un dermatologue. Il arrive avec votre dossier en main et repart avec un plan de soin clair.',
    image: null,
    imageBrief: 'Consultation en visio',
    imageDesc: "Femme chez elle en appel avec un médecin, écran visible et net. Cadrage large, pièce réelle, lumière naturelle.",
  },
  {
    number: '03',
    icon: 'calendarCheck',
    tag: 'Sans engagement',
    title: 'Votre suivi',
    body: 'Un point chaque mois pour ajuster votre traitement, et un suivi au quotidien entre les rendez-vous. Une peau suivie, pas juste traitée.',
    image: null,
    imageBrief: 'Application du soin, le soir',
    imageDesc: "Femme appliquant sa formule, le flacon blanc visible sur le lavabo. Salle de bain réelle, lumière chaude.",
  },
];

// Tarification transparente, reprise de la home.
const ledger = [
  { label: 'Bilan dermato', price: 'Gratuit', who: 'Avec notre assistant', get: 'Un dossier structuré, à vous' },
  { label: 'Consultation médicale', price: '49 €', who: 'Reversés intégralement au médecin', get: 'Un plan personnalisé, ordonnance si besoin', highlight: true },
  { label: "Suivi avec l'assistant IA Mixt", price: 'Inclus', who: 'Au quotidien, avec votre plan', get: "Questions pratiques sur le plan de traitement, journaling photo toutes les deux semaines, conseils cosméto. Pas de diagnostic ni d'avis médical." },
  { label: 'Préparation pharmacie', price: '30 à 60 €', who: 'Si prescrite, remboursement partiel', get: 'Formule magistrale sur-mesure' },
];

// FAQ médicale partagée, commune à toutes les pages concern.
const sharedFaq = [
  {
    q: 'Qui est le médecin ?',
    a: "Un médecin diplômé, inscrit à l'Ordre des Médecins, avec un RPPS vérifiable, expert de votre peau et supervisé par un dermatologue. C'est lui qui vous consulte, puis qui assure votre suivi mensuel si vous continuez.",
  },
  {
    q: 'Mes données et mes photos sont-elles protégées ?',
    a: "Oui. Vos données et vos photos sont hébergées sur des serveurs certifiés HDS (Hébergeur de Données de Santé) en France, et soumises au secret médical. Vos photos ne sont jamais transmises à un tiers : seul le médecin qui vous consulte peut les ouvrir, une fois votre rendez-vous réservé.",
  },
  {
    q: 'Aurai-je forcément une ordonnance ?',
    a: "La prescription relève de la seule décision du médecin. Selon votre cas, il peut prescrire une formule magistrale sur-mesure, un traitement dermatologique classique, ou recommander une approche essentiellement cosmétique. Dans tous les cas, vous repartez avec un avis médical personnalisé.",
  },
];

const faqEarly = concern.faqPosition === 'early';
const bottomFaq = faqEarly ? sharedFaq : [...concern.faq, ...sharedFaq];
const allFaq = [...concern.faq, ...sharedFaq];

// Règle photo : une image n'est affichée que si elle est de qualité brand (agence ou
// header de condition). `image: null` = pas de photo, plutôt qu'un visuel qui ne sert
// pas le message. Cf. règle "aplat plutôt que photo random".
const mechanismImage =
  concern.mechanism.image === null ? null : (concern.mechanism.image ?? '/images/lab-manipulation-vertical.jpg');
const cohortImage = concern.cohort ? concern.cohort.image : '/images/tuto-laeti-face.webp';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `https://mixt.care/${concern.slug}/#webpage`,
      url: `https://mixt.care/${concern.slug}/`,
      name: concern.seo.title,
      description: concern.seo.description,
      inLanguage: 'fr-FR',
      about: { '@type': 'MedicalCondition', name: concern.chip },
      isPartOf: { '@id': 'https://mixt.care/#organization' },
    },
    {
      '@type': 'FAQPage',
      '@id': `https://mixt.care/${concern.slug}/#faq`,
      mainEntity: allFaq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  title={concern.seo.title}
  description={concern.seo.description}
  structuredData={structuredData}
  noindex={concern.seo.noindex ?? false}
>
  <Nav ctaLabel={CTA_NAV} ctaHref={CTA_HREF} />

  {/* ── HERO (split asymétrique, image plein bord droit) ── */}
  <section class="relative bg-base overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 pt-[calc(56px+52px)] pb-12 lg:pt-[calc(56px+40px)] lg:pb-24 lg:min-h-[86vh] flex items-center">
      <div class="w-full lg:w-[53%] lg:pr-14">
        <FadeInSection client:load y={14}>
          {concern.heroProof && (
            <div class="flex items-center gap-2 mb-3.5">
              <span class="inline-flex items-center gap-[2px]">
                {[0, 1, 2, 3, 4].map(() => (
                  <span class="inline-flex items-center justify-center w-[15px] h-[15px] rounded-[2px]" style="background:#00b67a">
                    <span class="text-white text-[9px] leading-none">★</span>
                  </span>
                ))}
              </span>
              <span class="text-[12.5px] text-ink-2">{concern.heroProof.label}</span>
            </div>
          )}
          <div class="mb-5 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ember-deep">
            {concern.hero.kicker}
          </div>
          <h1 class="text-balance text-[38px] md:text-[48px] lg:text-[56px] font-medium leading-[1.06] tracking-[-0.035em] text-ink mb-6">
            {concern.hero.title}<br />
            <span class="italic-serif">{concern.hero.highlight}</span>
          </h1>
          <p class="text-[18px] md:text-[19px] leading-[1.65] text-ink-2 max-w-[540px] mb-9">
            {concern.hero.lead}
          </p>
        </FadeInSection>

        <FadeInSection client:load delay={0.25} y={10}>
          <div class="flex flex-wrap items-center gap-3">
            <Button href={CTA_HREF} variant="ember-pill">{CTA_LABEL} →</Button>
          </div>
          <p class="mt-3.5 text-[13px] leading-[1.5] text-ink-3 max-w-[420px]">{CTA_NOTE}</p>
          <div class="flex flex-wrap gap-x-6 gap-y-2.5 mt-7 text-[12.5px] text-ink-2">
            {trust.map((t) => (
              <span class="inline-flex items-center gap-1.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-[15px] h-[15px] text-jade-deep shrink-0"><Fragment set:html={icons[t.icon]} /></svg>
                {t.label}
              </span>
            ))}
          </div>
        </FadeInSection>
      </div>
    </div>

    {/* Image : bande pleine largeur sur mobile, plein bord droit pleine hauteur sur desktop */}
    <div class="relative h-[64vw] max-h-[440px] bg-blush/30 lg:h-auto lg:max-h-none lg:absolute lg:inset-y-0 lg:right-0 lg:w-[47%]">
      <img
        src={concern.hero.image}
        alt={concern.hero.imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${concern.hero.imagePosition ?? 'center 25%'};`}
        fetchpriority="high"
      />
    </div>
  </section>

  {/* ── PROBLEM ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
    <div class="max-w-[1180px] mx-auto grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-20 items-center">
      <div>
        <FadeInSection client:load>
          <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.12] tracking-[-0.035em] text-ink mb-8">
            {concern.problem.title}<br />
            <span>{concern.problem.highlight}</span>
          </h2>
        </FadeInSection>
        <FadeInSection client:load delay={0.1}>
          <div class="flex flex-col gap-5 text-[16.5px] md:text-[17.5px] leading-[1.7] text-rich">
            {concern.problem.paras.map((p) => <p>{p}</p>)}
          </div>
        </FadeInSection>
      </div>
      <FadeInSection client:load delay={0.15} y={20}>
        <PhotoSlot
          src={concern.problem.image ?? null}
          alt={concern.problem.imageAlt ?? ''}
          brief={concern.problem.imageBrief ?? 'Gros plan sur la condition'}
          desc={concern.problem.imageDesc}
          ratio="4/5"
          class="shadow-[0_20px_60px_-24px_rgba(54,24,34,0.32)]"
        />
      </FadeInSection>
    </div>
  </section>

  {/* ── CONTRAST (signature persona : prix / accès / cosméto vs prescription) ── */}
  {concern.contrast && (
    <section class="px-6 md:px-10 py-20 md:py-28 bg-base">
      <div class="max-w-[1100px] mx-auto">
        {concern.contrast.kicker && (
          <FadeInSection client:load>
            <div class="flex items-center justify-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ember-deep mb-10">
              <span class="inline-block h-[2px] w-7 bg-ember-deep/40"></span>
              {concern.contrast.kicker}
              <span class="inline-block h-[2px] w-7 bg-ember-deep/40"></span>
            </div>
          </FadeInSection>
        )}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px md:gap-px items-stretch rounded-[20px] overflow-hidden border border-black/[0.10]">
          <FadeInSection client:load y={16} className="h-full">
            <div class="h-full bg-cream p-9 md:p-12">
              <div class="text-[58px] md:text-[80px] font-medium tracking-[-0.04em] text-ink-3/50 leading-[0.92] mb-6">{concern.contrast.left.value}</div>
              <p class="text-[16px] md:text-[17px] leading-[1.5] text-ink-3 m-0">{concern.contrast.left.label}</p>
              {concern.contrast.left.items && (
                <ul class="mt-6 flex flex-col gap-2.5 list-none p-0 m-0">
                  {concern.contrast.left.items.map((it) => (
                    <li class="flex items-start gap-2.5 text-[14px] leading-[1.45] text-ink-3">
                      <span class="mt-[7px] inline-block h-[6px] w-[6px] rounded-full bg-ink-3/35 shrink-0"></span>
                      {it}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </FadeInSection>
          <FadeInSection client:load y={16} delay={0.1} className="h-full">
            <div class="h-full bg-deep text-white p-9 md:p-12">
              <div class="text-[58px] md:text-[80px] font-medium tracking-[-0.04em] text-ember leading-[0.92] mb-6">{concern.contrast.right.value}</div>
              <p class="text-[16px] md:text-[17px] leading-[1.5] text-white/85 m-0">{concern.contrast.right.label}</p>
              {concern.contrast.right.items && (
                <ul class="mt-6 flex flex-col gap-2.5 list-none p-0 m-0">
                  {concern.contrast.right.items.map((it) => (
                    <li class="flex items-start gap-2.5 text-[14px] leading-[1.45] text-white/80">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-[3px] w-[14px] h-[14px] text-mint shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
                      {it}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </FadeInSection>
        </div>
        {concern.contrast.note && (
          <FadeInSection client:load delay={0.15}>
            <p class="text-center text-[13.5px] text-ink-3 leading-relaxed mt-7 max-w-[620px] mx-auto">{concern.contrast.note}</p>
          </FadeInSection>
        )}
      </div>
    </section>
  )}

  {/* ── OBJECTIONS (traitées haut de page, pas enterrées en FAQ) ── */}
  {faqEarly && (
    <section class="px-6 md:px-10 py-20 md:py-24 bg-cream">
      <div class="max-w-[820px] mx-auto">
        <FadeInSection client:load>
          <h2 class="text-balance text-[30px] md:text-[40px] font-medium leading-[1.1] tracking-[-0.035em] text-ink mb-10">
            {concern.objectionsTitle ?? 'Ce que vous vous demandez'} <span>déjà.</span>
          </h2>
        </FadeInSection>
        <Accordion client:load items={concern.faq} />
      </div>
    </section>
  )}

  {/* ── MECHANISM + ACTIFS (registre vert scientifique : actifs, labo, preuves) ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-sage-deep text-white">
    <div class="max-w-[1180px] mx-auto">
      <FadeInSection client:load>
        <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-mint mb-8">
          <span class="inline-block h-[2px] w-7 bg-mint/70"></span>
          La science dermatologique
        </div>
      </FadeInSection>

      <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 items-start">
        <FadeInSection client:load delay={0.1} y={20}>
          <div class="lg:sticky lg:top-28">
            <PhotoSlot
              src={mechanismImage}
              alt={concern.mechanism.imageAlt ?? "Préparation d'une formule magistrale en pharmacie"}
              brief={concern.mechanism.imageBrief ?? 'Macro peau'}
              desc={concern.mechanism.imageDesc}
              tone="dark"
              ratio="4/5"
              badge={concern.mechanism.imageBadge === '' ? undefined : (concern.mechanism.imageBadge ?? 'Préparé en pharmacie')}
              class="shadow-[0_20px_60px_-22px_rgba(54,24,34,0.32)]"
            />
          </div>
        </FadeInSection>

        {/* Pédagogie + actifs */}
        <div>
          <FadeInSection client:load>
            <p class="text-[22px] md:text-[28px] font-medium leading-[1.3] tracking-[-0.02em] text-white mb-3">
              {concern.mechanism.lede}
            </p>
            <p class="text-[16px] md:text-[17px] leading-[1.7] text-white/70 mb-10">
              {concern.mechanism.body}
            </p>
          </FadeInSection>

          <FadeInSection client:load delay={0.1}>
            <div class="rounded-[16px] bg-white/[0.06] border border-white/15 p-6 md:p-8">
              <p class="text-[13.5px] md:text-[14px] text-white/65 leading-[1.5] mb-5">
                Les actifs utilisés en dermatologie sur cette condition.
              </p>
              <div class="hidden sm:grid sm:grid-cols-[200px_1fr] gap-x-8 pb-2.5 border-b border-white/20">
                <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-mint font-medium">Actif</span>
                <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-mint font-medium">Effet</span>
              </div>
              {concern.mechanism.actifs.map((a, i) => (
                <div class={`grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-x-8 gap-y-1 py-3.5 items-baseline ${i > 0 ? 'border-t border-white/10' : ''}`}>
                  <span class="text-[14px] sm:text-[14.5px] font-semibold text-white tracking-[-0.005em]">{a.name}</span>
                  <p class="text-[13.5px] leading-[1.5] text-white/70 m-0">
                    <strong class="font-semibold text-white">{a.bold}</strong>{a.rest ? ' ' + a.rest : (/[.!?]$/.test(a.bold) ? '' : '.')}
                  </p>
                </div>
              ))}
              <div class="mt-4 pt-3.5 border-t border-white/10 text-[12.5px] text-white/55 leading-[1.55]">
                {concern.mechanism.footer} Ces actifs ne sont pas disponibles en cosmétique : ils sont prescrits et préparés en pharmacie sur ordonnance médicale.
              </div>
            </div>
          </FadeInSection>
        </div>
      </div>
    </div>
  </section>

  {/* ── PROOF ── */}
  {concern.proof ? (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
      <div class="max-w-[1100px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-jade-deep mb-5">
            <span class="inline-block h-[2px] w-7 bg-jade-deep/80"></span>
            Résultats réels
          </div>
          <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-ink mb-12 md:mb-14 max-w-[680px]">
            Elle a suivi le parcours <span class="whitespace-nowrap">avant vous.</span>
          </h2>
        </FadeInSection>
        <div class="grid grid-cols-1 lg:grid-cols-[55%_45%] gap-10 lg:gap-14 items-center">
          <BeforeAfterReveal
            client:load
            before={concern.proof.before}
            after={concern.proof.after}
            afterLabel={concern.proof.afterLabel}
          />
          <FadeInSection client:load delay={0.15}>
            <h3 class="text-[22px] md:text-[24px] font-semibold text-ink mb-1 tracking-[-0.02em]">{concern.proof.name}</h3>
            <div class="text-[13px] uppercase tracking-[0.12em] text-ink-3 font-semibold mb-6">{concern.proof.meta}</div>
            <blockquote class="italic-serif text-[24px] md:text-[30px] leading-[1.45] text-ink mb-6 pb-6 border-b border-black/[0.08]">
              « {concern.proof.quote} »
            </blockquote>
            <p class="text-[14.5px] text-ink-2 leading-relaxed max-w-[480px]">{concern.proof.context}</p>
            <p class="mt-4 text-[11px] text-ink-3 italic leading-snug">{concern.proof.legal}</p>
            <div class="mt-8">
              <Button href={CTA_HREF} variant="dark">{CTA_LABEL} →</Button>
            </div>
          </FadeInSection>
        </div>
      </div>
    </section>
  ) : (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
      <div class="max-w-[1100px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-jade-deep mb-12 md:mb-14">
            <span class="inline-block h-[2px] w-7 bg-jade-deep/80"></span>
            Commencer maintenant
          </div>
        </FadeInSection>
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-center">
          <FadeInSection client:load delay={0.1} y={20}>
            <div class="relative">
              <PhotoSlot
                src={cohortImage}
                alt={concern.cohort?.imageAlt ?? 'Laetitia, co-fondatrice de Mixt'}
                brief={concern.cohort?.imageBrief ?? 'Portrait patiente'}
                desc={concern.cohort?.imageDesc}
                ratio="4/5"
                rounded="rounded-3xl"
                class="shadow-[0_20px_60px_-22px_rgba(54,24,34,0.32)]"
              />
              {(concern.cohort ? concern.cohort.name : 'Laetitia') && (
                <div class="absolute left-5 bottom-5 z-[5] rounded-[6px] bg-deep px-3 py-2 text-white">
                  <div class="text-[15px] font-semibold leading-tight">{concern.cohort ? concern.cohort.name : 'Laetitia'}</div>
                  {(concern.cohort ? concern.cohort.role : 'Co-fondatrice de Mixt') && (
                    <div class="text-[12px] text-white/85">{concern.cohort ? concern.cohort.role : 'Co-fondatrice de Mixt'}</div>
                  )}
                </div>
              )}
            </div>
          </FadeInSection>

          {/* Invitation à consulter */}
          <FadeInSection client:load delay={0.15}>
            <h2 class="text-balance text-[30px] md:text-[42px] font-medium leading-[1.1] tracking-[-0.03em] text-ink mb-5">
              Reprenez la main sur votre {concern.chip.toLowerCase()},<br />
              <span>dès cette semaine.</span>
            </h2>
            <p class="text-[16px] md:text-[18px] leading-[1.7] text-ink-2 mb-8 max-w-[520px]">
              Le bilan est gratuit et prend 5 minutes. Vous repartez de votre consultation avec un plan de traitement personnalisé, et un médecin qui l'ajuste mois après mois.
            </p>
            <Button href={CTA_HREF} variant="ember-pill">{CTA_LABEL} →</Button>
            <div class="flex flex-wrap gap-x-6 gap-y-2.5 mt-8 text-[12.5px] text-ink-2">
              {trust.map((t) => (
                <span class="inline-flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-[15px] h-[15px] text-jade-deep shrink-0"><Fragment set:html={icons[t.icon]} /></svg>
                  {t.label}
                </span>
              ))}
            </div>
          </FadeInSection>
        </div>
      </div>
    </section>
  )}

  {/* ── MID CTA (relance bénéfice, photo paysage optionnelle) ── */}
  <section class="relative overflow-hidden bg-deep text-white">
    {(concern.midCta?.image || concern.midCta?.imageBrief) && (
      <div class="absolute inset-y-0 right-0 hidden lg:block w-[42%]">
        <PhotoSlot
          src={concern.midCta.image ?? null}
          alt={concern.midCta.imageAlt ?? ''}
          brief={concern.midCta.imageBrief ?? ''}
          desc={concern.midCta.imageDesc}
          tone="dark"
          ratio="auto"
          rounded=""
          class="absolute inset-0 h-full w-full"
        />
      </div>
    )}
    <div class={`relative z-[2] px-6 md:px-10 py-14 md:py-20 max-w-[1100px] mx-auto flex flex-col gap-7 ${(concern.midCta?.image || concern.midCta?.imageBrief) ? 'lg:pr-[48%] lg:min-h-[340px] lg:justify-center' : 'md:flex-row md:items-center md:justify-between'}`}>
      <FadeInSection client:load>
        <div class="font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ember mb-3">
          {concern.midCta?.kicker ?? 'Prête à avancer ?'}
        </div>
        <p class="text-balance text-[22px] md:text-[28px] font-medium leading-[1.3] tracking-[-0.02em] text-white max-w-[560px]">
          {concern.midCta?.title ?? `Arrêtez de tâtonner sur votre ${concern.chip.toLowerCase()}.`}<br />
          <span class="italic-serif text-white/85">
            {concern.midCta?.highlight ?? 'Une peau suivie, pas juste traitée.'}
          </span>
        </p>
      </FadeInSection>
      <FadeInSection client:load delay={0.1}>
        <div class="flex flex-wrap items-center gap-3">
          <Button href={CTA_HREF} variant="white" class="shrink-0 whitespace-nowrap">{CTA_LABEL} →</Button>
          <span class="text-[13px] text-white/55 max-w-[280px] leading-snug">{CTA_NOTE}</span>
        </div>
      </FadeInSection>
    </div>
  </section>

  {/* ── EXPECTATIONS (optional) ── */}
  {concern.expectations && (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
      <div class="max-w-[1100px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-violet mb-5">
            <span class="inline-block h-[2px] w-7 bg-violet/80"></span>
            Le rythme du traitement
          </div>
          <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.12] tracking-[-0.035em] text-ink mb-3 max-w-[760px]">
            {concern.expectations.title}{' '}
            <span class="whitespace-nowrap">{concern.expectations.highlight}</span>
          </h2>
          {concern.expectations.intro && (
            <p class="text-[16px] md:text-[17px] leading-[1.7] text-ink-2 max-w-[620px] mb-12">
              {concern.expectations.intro}
            </p>
          )}
        </FadeInSection>
        {/* Device signature : courbe de suivi S.0 -> S.12 (charte Mixt) */}
        <FadeInSection client:load delay={0.1} y={18}>
          <div class="mb-14 md:mb-16 rounded-[20px] bg-base border border-black/[0.08] p-7 md:p-10">
            <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ink-3 mb-7">
              <span class="inline-block h-[2px] w-7 bg-ink-3/40"></span>
              {concern.chip} · les 12 premières semaines
            </div>
            <ProgressCurve
              client:visible
              label={concern.chip}
              pace={concern.expectations.curve?.pace}
              improveLabel={concern.expectations.curve?.improveLabel}
              sideEffectLabel={concern.expectations.curve?.sideEffectLabel}
              milestones={concern.expectations.curve?.milestones}
            />
          </div>
        </FadeInSection>
        {concern.expectations.footnote && (
          <FadeInSection client:load delay={0.15}>
            <p class="mt-12 pt-8 border-t border-black/[0.08] text-[13.5px] text-ink-2 italic leading-relaxed max-w-[720px]">
              {concern.expectations.footnote}
            </p>
          </FadeInSection>
        )}
      </div>
    </section>
  )}

  {/* ── HOW IT WORKS ── */}
  <section id="parcours" class="relative overflow-hidden px-6 md:px-10 py-24 md:py-32 bg-deep text-white scroll-mt-20">
    <div class="relative z-[2] max-w-[1200px] mx-auto">
      <FadeInSection client:load>
        <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ember mb-5">
          <span class="inline-block h-[2px] w-7 bg-ember/80"></span>
          Le parcours
        </div>
        <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.1] tracking-[-0.035em] text-white mb-16 max-w-[640px]">
          De votre dossier à votre suivi, <span class="whitespace-nowrap">en trois temps.</span>
        </h2>
      </FadeInSection>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {steps.map((s, i) => (
          <FadeInSection client:load delay={i * 0.1} y={18} className="h-full">
            <div class="relative h-full overflow-hidden rounded-[20px] bg-base" style="aspect-ratio:3/4;">
              <PhotoSlot
                src={s.image}
                alt={s.title}
                brief={s.imageBrief}
                desc={s.imageDesc}
                ratio="3/4"
                rounded=""
                class="absolute inset-0 h-full w-full [&>div]:pb-[38%]"
              />
              {/* pastille de marque posée sur la photo */}
              <div class="absolute left-4 top-4 z-[5] inline-flex items-center gap-2 rounded-full bg-deep px-3 py-1.5">
                <span class="font-mono text-[10px] font-semibold tracking-[0.16em] uppercase text-ember">{s.number}</span>
                <span class="inline-block h-[10px] w-px bg-white/25"></span>
                <span class="font-mono text-[10px] tracking-[0.1em] uppercase text-white/80">{s.tag}</span>
              </div>
              {/* aplat opaque dans l'image : jamais de dégradé */}
              <div class="absolute inset-x-3 bottom-3 z-[5] rounded-[14px] bg-deep px-5 py-5">
                <div class="flex items-center gap-2.5 mb-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-[17px] h-[17px] text-ember shrink-0"><Fragment set:html={icons[s.icon]} /></svg>
                  <h3 class="text-[18px] md:text-[19px] font-semibold text-white leading-tight tracking-[-0.01em] m-0">{s.title}</h3>
                </div>
                <p class="text-[13.5px] leading-[1.55] text-white/70 m-0">{s.body}</p>
              </div>
            </div>
          </FadeInSection>
        ))}
      </div>
    </div>
  </section>

  {/* ── LE TRAITEMENT (ce que le patient reçoit réellement) ── */}
  {concern.treatment && (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-base">
      <div class="max-w-[1000px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ember-deep mb-6">
            <span class="inline-block h-[2px] w-7 bg-ember-deep/80"></span>
            {concern.treatment.kicker ?? 'Votre traitement'}
          </div>
          <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.1] tracking-[-0.035em] text-ink mb-4 max-w-[680px]">
            {concern.treatment.title}<br />
            <span>{concern.treatment.highlight}</span>
          </h2>
        </FadeInSection>
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-center mb-12">
          <FadeInSection client:load y={20}>
            {concern.treatment.label ? (
              <PrescriptionLabel
                formula={concern.treatment.label.formula}
                lines={concern.treatment.label.lines}
                base={concern.treatment.label.base}
                note={concern.treatment.label.note}
              />
            ) : (
              <PhotoSlot
                src={concern.treatment.image ?? null}
                alt={concern.treatment.imageAlt ?? ''}
                brief={concern.treatment.imageBrief ?? 'Préparation magistrale'}
                desc={concern.treatment.imageDesc}
                ratio="4/5"
                class="shadow-[0_20px_60px_-24px_rgba(54,24,34,0.32)]"
              />
            )}
          </FadeInSection>
          <FadeInSection client:load delay={0.1}>
            <p class="text-[16px] md:text-[17px] leading-[1.7] text-ink-2">{concern.treatment.lead}</p>
          </FadeInSection>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
          {concern.treatment.benefits.map((b, i) => (
            <FadeInSection client:load delay={i * 0.08} y={16}>
              <div class="border-t border-black/[0.12] pt-5">
                <div class="font-mono text-[12px] tracking-[0.14em] uppercase text-ember-deep mb-3">{b.label}</div>
                <p class="text-[15px] leading-[1.6] text-rich m-0">{b.body}</p>
              </div>
            </FadeInSection>
          ))}
        </div>
        <FadeInSection client:load delay={0.2}>
          <p class="mt-10 pt-7 border-t border-black/[0.08] text-[13px] text-ink-3 leading-relaxed max-w-[720px]">
            {concern.treatment.footnote}
          </p>
        </FadeInSection>
      </div>
    </section>
  )}

  {/* ── AUTORITÉ MÉDICALE (un vrai visage derrière la promesse) ── */}
  {concern.authority && (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
      <div class="max-w-[1100px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-jade-deep mb-10 md:mb-12">
            <span class="inline-block h-[2px] w-7 bg-jade-deep/80"></span>
            {concern.authority.kicker ?? 'Qui est derrière votre protocole'}
          </div>
        </FadeInSection>
        <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 items-center">
          <FadeInSection client:load y={20}>
            <div class="relative aspect-[4/5] overflow-hidden rounded-3xl bg-blush/30 shadow-[0_20px_60px_-22px_rgba(54,24,34,0.32)]">
              <img src={concern.authority.image} alt={concern.authority.imageAlt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
              <div class="absolute left-5 bottom-5 z-[5] rounded-[6px] bg-deep px-3 py-2 text-white">
                <div class="text-[15px] font-semibold leading-tight">{concern.authority.name}</div>
                <div class="text-[12px] text-white/85">{concern.authority.role}</div>
              </div>
            </div>
          </FadeInSection>
          <FadeInSection client:load delay={0.1}>
            <h2 class="text-balance text-[30px] md:text-[42px] font-medium leading-[1.1] tracking-[-0.03em] text-ink mb-6">
              {concern.authority.title}<br />
              <span>{concern.authority.highlight}</span>
            </h2>
            <blockquote class="italic-serif text-[22px] md:text-[26px] leading-[1.45] text-ink mb-7 pb-7 border-b border-black/[0.08]">
              « {concern.authority.quote} »
            </blockquote>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              {concern.authority.points.map((pt) => (
                <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-rich">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-[4px] w-[15px] h-[15px] text-jade-deep shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
                  {pt}
                </li>
              ))}
            </ul>
          </FadeInSection>
        </div>
      </div>
    </section>
  )}

  {/* ── AVIS (verbatim Trustpilot réel, juste avant le prix) ── */}
  {concern.review && (
    <section class="px-6 md:px-10 py-20 md:py-24 bg-base">
      <div class="max-w-[820px] mx-auto text-center">
        <FadeInSection client:load>
          <div class="inline-flex items-center gap-3 rounded-full bg-cream px-5 py-2.5 mb-10">
            <span class="inline-flex items-center gap-[3px]">
              {[0, 1, 2, 3, 4].map(() => (
                <span class="inline-flex items-center justify-center w-[21px] h-[21px] rounded-[3px]" style="background:#00b67a">
                  <span class="text-white text-[13px] leading-none">★</span>
                </span>
              ))}
            </span>
            <span class="text-[15px] text-ink"><strong class="font-semibold">Trustpilot</strong> · avis vérifiés</span>
          </div>
          <blockquote class="italic-serif text-[30px] md:text-[44px] leading-[1.32] text-ink mb-8 tracking-[-0.01em]">
            « {concern.review.quote} »
          </blockquote>
          <div class="flex items-center justify-center gap-3">
            <span class="text-[17px] font-semibold text-ink">{concern.review.name}</span>
            <span class="rounded-[6px] bg-deep px-3 py-1.5 text-[10.5px] font-semibold tracking-[0.16em] uppercase text-white">{concern.review.tag}</span>
          </div>
        </FadeInSection>
      </div>
    </section>
  )}

  {/* ── PRICING ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-base">
    <div class="max-w-[1200px] mx-auto">
      <FadeInSection client:load>
        <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-center max-w-[820px] mx-auto mb-4 text-ink">
          Combien ça coûte, <span class="whitespace-nowrap">exactement.</span>
        </h2>
        <p class="text-center text-[15px] md:text-[16px] text-ink-2 max-w-[620px] mx-auto leading-relaxed">
          La transparence, dès le premier jour. Les 49 € de la consultation reviennent intégralement au médecin : Mixt ne prélève rien dessus. Vous ne payez que si vous décidez de réserver.
        </p>
      </FadeInSection>
      <FadeInSection client:load delay={0.1}>
        <div class="max-w-[860px] mx-auto mt-14 overflow-hidden rounded-[12px] border border-black/[0.08] bg-base">
          {ledger.map((row, i) => (
            <div class={`flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 px-5 md:px-7 py-5 ${i < ledger.length - 1 ? 'border-b border-black/[0.07]' : ''} ${row.highlight ? 'bg-cream/60' : ''}`}>
              <div class="sm:w-[230px] shrink-0">
                <div class="text-[15px] font-semibold text-ink">{row.label}</div>
                <div class="text-[12px] text-ink-3 mt-0.5">{row.who}</div>
              </div>
              <div class="flex-1 text-[13.5px] text-ink-2 leading-snug order-3 sm:order-2">{row.get}</div>
              <div class={`order-2 sm:order-3 sm:text-right font-semibold tracking-[-0.02em] ${row.highlight ? 'text-[28px] text-ink' : 'text-[20px] text-ink'}`}>{row.price}</div>
            </div>
          ))}
        </div>
      </FadeInSection>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="px-6 md:px-10 pt-24 md:pt-32 pb-16 md:pb-24 bg-cream">
    <div class="max-w-[1200px] mx-auto">
      <FadeInSection client:load>
        <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-center mb-12 md:mb-16 text-ink">
          Vos dernières <span class="whitespace-nowrap">questions.</span>
        </h2>
      </FadeInSection>
      <div class="max-w-[760px] mx-auto">
        <Accordion client:load items={bottomFaq} />
      </div>
    </div>
  </section>

  {/* ── RELATED ── */}
  {concern.related.length > 0 && (
    <section class="px-6 md:px-10 pb-24 md:pb-28 bg-cream">
      <div class="max-w-[860px] mx-auto">
        <FadeInSection client:load>
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-3 mb-6 text-center">Autres préoccupations</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {concern.related.map((r) => (
              <a href={r.href} class="group block rounded-2xl border border-black/[0.08] bg-base px-6 py-5 no-underline transition-colors hover:border-ink/25">
                <div class="flex items-center justify-between">
                  <span class="text-[16px] font-semibold text-ink">{r.label}</span>
                  <span class="text-ember transition-transform group-hover:translate-x-[3px]" aria-hidden>→</span>
                </div>
                <p class="text-[13.5px] text-ink-2 leading-snug mt-1.5">{r.teaser}</p>
              </a>
            ))}
          </div>
        </FadeInSection>
      </div>
    </section>
  )}

  {/* ── FINAL CTA ── */}
  <section class="relative overflow-hidden px-6 md:px-10 py-24 md:py-32 bg-deep text-white text-center">
    <div class="relative z-[2] max-w-[780px] mx-auto">
      <FadeInSection client:load>
        <h2 class="text-balance text-[34px] md:text-[46px] font-medium leading-[1.12] tracking-[-0.035em] text-white mb-6 max-w-[680px] mx-auto">
          Et si on s'en occupait <span class="italic-serif whitespace-nowrap">vraiment ?</span>
        </h2>
        <p class="text-[16px] md:text-[18px] leading-[1.65] text-white/60 max-w-[520px] mx-auto mb-9">
          Bilan gratuit en 5 minutes, consultation sous 7 jours, plan de traitement personnalisé. Vous ne payez que si vous décidez de réserver.
        </p>
        <Button href={CTA_HREF} variant="white">{CTA_LABEL} →</Button>
        <div class="mt-5 text-[13px] text-white/60">{CTA_NOTE}</div>
      </FadeInSection>
    </div>
  </section>

  <Footer />
</BaseLayout>
