---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import Accordion from '../motion/Accordion.tsx';
import FadeInSection from '../motion/FadeInSection.tsx';
import BeforeAfterReveal from '../motion/BeforeAfterReveal.tsx';
import V3Dermatologue from '../sections-v3/V3Dermatologue.astro';
import DossierTimeline from '../motion/DossierTimeline.tsx';
import EquipeMedicale from '../EquipeMedicale.astro';
import MotFondatrice from '../MotFondatrice.astro';
import MobileStickyCta from '../MobileStickyCta.astro';
import type { Concern } from '../../data/concerns/types';
import { breadcrumb, ORG_ID, WEBSITE_ID, DERMATO_ID, dermatologist } from '../../data/schema';

interface Props {
  concern: Concern;
}

const { concern } = Astro.props;

// CTA concern-aware : on transporte le concern jusqu'à la waitlist pour pré-remplir
// le message WhatsApp / l'email et garder la continuité d'intention.
const CTA_HREF = 'https://app.mixt.care/rdv';
const CTA_LABEL = 'Faire mon bilan gratuit';
const CTA_NOTE = 'Bilan gratuit et sans engagement. Consultation à 49 €, seulement si vous la réservez.';

// Jeu d'icônes minimal (tracés Lucide, stroke 1.5), inline pour éviter une dépendance.
const icons: Record<string, string> = {
  fileText:
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  stethoscope:
    '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  calendarCheck:
    '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  badgeCheck:
    '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>',
  shieldCheck:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};

// Mobile : mêmes arguments que la home, un par ligne.
const proofMobile = [
  'Un médecin en visio sous 7 jours',
  'Formule en pharmacie, si prescrite',
  'Suivi inclus, sans abonnement',
];

// Bandeau de réassurance du hero.
const trust = [
  { icon: 'stethoscope', label: 'Médecin partenaire' },
  { icon: 'badgeCheck', label: 'Supervisé par un dermatologue' },
  { icon: 'shieldCheck', label: 'Données hébergées en France (HDS)' },
];


// Bloc « dossier » : ce que le médecin prend en compte (plateforme de marque, 11/2026).
const dossier = [
  { label: 'Votre historique', when: 'Avant' },
  { label: 'Vos photos', when: 'Avant' },
  { label: 'Ce que vous avez déjà essayé', when: 'Avant' },
  { label: 'Une décision médicale', when: 'En visio', key: true },
  { label: 'Votre protocole', when: 'Après' },
  { label: 'Votre suivi', when: 'Dans la durée' },
];

// Tarification transparente, reprise de la home.
const ledger = [
  { label: 'Bilan dermato', price: 'Gratuit', who: 'En ligne, en 5 minutes', get: 'Un dossier structuré, à vous' },
  { label: 'Consultation médicale', price: '49 €', who: 'Reversés intégralement au médecin', get: 'Un plan personnalisé, ordonnance si besoin', highlight: true },
  { label: "Suivi par l'équipe Mixt", price: 'Inclus', who: 'Au quotidien, avec votre plan', get: "Une équipe joignable pour vos questions pratiques sur le plan de traitement, un journal photo toutes les deux semaines, des conseils cosméto. Pas de diagnostic ni d'avis médical." },
  { label: 'Suivi par le médecin', price: '29 €/mois', who: 'Optionnel, sans engagement, résiliable', get: "Point mensuel sur 3 à 6 mois pour adapter ou renouveler le plan de traitement et l'ordonnance si besoin." },
  { label: 'Préparation pharmacie', price: '30 à 60 €', note: 'Prix indicatif', who: 'Si prescrite, prise en charge selon couverture', get: 'Formule magistrale sur-mesure' },
];

// FAQ médicale partagée, commune à toutes les pages concern.
const sharedFaq = [
  {
    q: 'Qui est le médecin ?',
    a: "Un médecin diplômé, inscrit à l'Ordre des Médecins, avec un RPPS vérifiable, expert de votre peau et supervisé par un dermatologue. C'est lui qui vous consulte, puis qui assure votre suivi mensuel si vous continuez.",
  },
  {
    q: 'Mes données et mes photos sont-elles protégées ?',
    a: "Oui. Vos données et vos photos sont hébergées en France, dans un environnement certifié HDS (Hébergeur de Données de Santé), et soumises au secret médical. Leur accès est sécurisé et réservé aux personnes habilitées, dans le cadre de votre prise en charge.",
  },
  {
    q: 'Aurai-je forcément une ordonnance ?',
    a: "La prescription relève de la seule décision du médecin. Selon votre cas, il peut prescrire une formule magistrale sur-mesure, un traitement dermatologique classique, ou recommander une approche essentiellement cosmétique. Dans tous les cas, vous repartez avec un avis médical personnalisé.",
  },
];

// Questions pratiques (prix, délai) : très cherchées, elles lèvent aussi les objections d'achat.
const practicalFaq = [
  {
    q: 'Combien coûte la prise en charge ?',
    a: "Le bilan en ligne est gratuit. La consultation coûte 49 €, qui rémunèrent intégralement le médecin et ne sont débités qu'une fois la téléconsultation effectuée. Si le médecin prescrit une préparation en pharmacie, comptez 30 à 60 € (prix indicatif), avec une prise en charge éventuelle selon votre couverture santé. Le suivi par le médecin est optionnel : 29 € par mois, sans engagement.",
  },
  {
    q: 'Sous quel délai puis-je voir un médecin ?',
    a: "Vous faites votre bilan en ligne en 5 minutes, puis vous réservez une visio avec un médecin partenaire, sous 7 jours. Le médecin étudie votre dossier et vos photos avant la consultation.",
  },
];

const allFaq = [...concern.faq, ...practicalFaq, ...sharedFaq];

// Bandeau sous le hero : comment, quand, combien, sans descendre de quatre écrans.
const steps = [
  { n: 'Étape 1', title: 'Bilan gratuit en 5 minutes', text: 'Quelques questions et vos photos. Votre médecin les étudie avant la consultation.' },
  { n: 'Étape 2', title: 'Visio avec un médecin sous 7 jours', text: 'Consultation à 49 €, débitée seulement une fois la téléconsultation effectuée.' },
  { n: 'Étape 3', title: 'Votre plan de traitement, puis le suivi', text: "Ordonnance si besoin, journal photo et équipe Mixt joignable pour vos questions pratiques." },
];
const priceStrip = [
  { label: 'Bilan en ligne', price: 'Gratuit' },
  { label: 'Consultation médicale', price: '49 €' },
  { label: 'Suivi par le médecin', price: '29 €/mois', note: 'Optionnel' },
  { label: 'Préparation pharmacie', price: '30 à 60 €', note: 'Indicatif, si prescrite' },
];

const pageUrl = `https://mixt.care/${concern.slug}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: concern.seo.title,
      description: concern.seo.description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': WEBSITE_ID },
      publisher: { '@id': ORG_ID },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      about: { '@id': `${pageUrl}#condition` },
      mentions: { '@id': DERMATO_ID },
    },
    {
      '@type': 'MedicalCondition',
      '@id': `${pageUrl}#condition`,
      name: concern.condition.name,
      ...(concern.condition.alternateName && { alternateName: concern.condition.alternateName }),
    },
    breadcrumb(pageUrl, concern.chip),
    dermatologist,
    {
      '@type': 'FAQPage',
      '@id': `https://mixt.care/${concern.slug}/#faq`,
      mainEntity: allFaq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  title={concern.seo.title}
  description={concern.seo.description}
  structuredData={structuredData}
>
  <Nav ctaLabel="Démarrer ma consultation" ctaHref={CTA_HREF} stickyCtaMobile />

  {/* ── HERO MOBILE : même pattern que la home (Trustpilot, titre, photo, réassurance, CTA collé en bas) ── */}
  <section class="lg:hidden bg-base px-6 pt-[calc(56px+20px)] pb-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="flex items-center gap-[3px]">
        {[0, 1, 2, 3, 4].map(() => (
          <span class="inline-flex h-[16px] w-[16px] items-center justify-center rounded-[2px]" style="background:#00b67a">
            <span class="text-[10px] leading-none text-white">★</span>
          </span>
        ))}
      </span>
      <span class="text-[13px] font-medium text-ink-2">Avis vérifiés Trustpilot</span>
    </div>
    <h1 class="text-balance text-[min(27px,6.9vw)] font-semibold leading-[1.14] tracking-[-0.04em] text-ink m-0">
      {concern.hero.title}<br />
      {concern.hero.highlight}
    </h1>
    <p class="mt-3 text-[15.5px] leading-[1.5] text-ink-2">{concern.hero.leadShort}</p>
    <div class="relative mt-5 aspect-[4/5] overflow-hidden rounded-[20px] bg-cream">
      <img
        src={concern.hero.image}
        alt={concern.hero.imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${concern.hero.imagePositionMobile ?? concern.hero.imagePosition ?? 'center 30%'};`}
        fetchpriority="high"
      />
      <div class="absolute left-3 top-3 z-[5] flex items-center gap-3 rounded-[12px] bg-white px-3.5 py-2.5 shadow-[0_8px_28px_-10px_rgba(50,25,34,0.28)]">
        <img src="/images/shoot-dermatologue-avatar.webp" alt="" aria-hidden="true" width="36" height="36" class="h-9 w-9 shrink-0 rounded-full object-cover border border-black/[0.06]" />
        <span>
          <span class="block text-[13.5px] font-semibold leading-tight text-ink">Plan de traitement prêt</span>
          <span class="block mt-0.5 text-[12px] leading-tight text-ink-3">Validé par votre médecin</span>
        </span>
      </div>
    </div>
    <ul class="list-none m-0 mt-5 rounded-[14px] bg-white border border-black/[0.06] px-4 py-3.5 flex flex-col gap-2.5">
      {proofMobile.map((t) => (
        <li class="flex items-center gap-2.5 text-[15px] leading-snug text-ink">
          <svg class="h-[18px] w-[18px] shrink-0 text-jade" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 10.5 L8 15 L16.5 5.5" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {t}
        </li>
      ))}
    </ul>
  </section>

  {/* ── HERO : vraie peau bord à bord à gauche, panneau texte à droite (DA marque 11/2026) ── */}
  <section class="bg-base lg:pt-14">
    <div class="hidden lg:flex flex-col lg:flex-row">
      <div class="relative w-full aspect-[4/5] max-h-[600px] lg:max-h-none lg:w-auto lg:h-[min(calc(100vh-56px),900px)] lg:shrink-0 bg-blush/30 overflow-hidden">
        <img
          src={concern.hero.image}
          alt={concern.hero.imageAlt}
          class="absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${concern.hero.imagePosition ?? 'center 30%'};`}
          fetchpriority="high"
        />
      </div>
      <div class="flex flex-1 items-center px-6 md:px-10 lg:px-16 xl:px-24 py-12 lg:py-16">
        <div class="max-w-[560px]">
          <FadeInSection client:load y={14}>
            <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-6">
              {concern.hero.kicker}
            </div>
            <h1 class="text-balance text-[36px] md:text-[46px] lg:text-[52px] font-bold leading-[1.05] tracking-[-0.035em] text-ink mb-6">
              {concern.hero.title}<br />
              {concern.hero.highlight}
            </h1>
            <p class="text-[17px] md:text-[19px] leading-[1.6] text-ink-2 mb-8">
              {concern.hero.lead}
            </p>
          </FadeInSection>
          <FadeInSection client:load delay={0.2} y={10}>
            <div class="flex flex-wrap items-center gap-3">
              <Button href={CTA_HREF} variant="ember-pill">{CTA_LABEL} →</Button>
              <Button href="#parcours" variant="ghost">Comment ça marche</Button>
            </div>
            <p class="mt-4 text-[13px] text-ink-3">{CTA_NOTE}</p>
            <div class="flex flex-wrap gap-x-6 gap-y-2.5 mt-7 text-[12.5px] text-ink-2">
              {trust.map((t) => (
                <span class="inline-flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-[15px] h-[15px] text-jade-deep shrink-0"><Fragment set:html={icons[t.icon]} /></svg>
                  {t.label}
                </span>
              ))}
            </div>
          </FadeInSection>
        </div>
      </div>
    </div>

    {/* Bande texture signature de la condition, slogan blanc posé sur la photo (pas de voile) */}
    <div class="relative h-[52vw] max-h-[420px] min-h-[240px] overflow-hidden bg-deep">
      <img
        src={concern.band.image}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${concern.band.imagePosition ?? 'center'};`}
        loading="eager"
      />
      <p class="absolute left-6 md:left-10 lg:left-16 bottom-7 md:bottom-12 max-w-[640px] text-balance text-[38px] md:text-[60px] lg:text-[72px] font-bold leading-[1] tracking-[-0.045em] text-white [text-shadow:0_1px_12px_rgba(0,0,0,0.25)]">
        {concern.band.slogan}
      </p>
    </div>
  </section>


  {/* ── COMMENT ÇA SE PASSE : 3 étapes + prix, puis l'objection n°1 ── */}
  <section class="px-6 md:px-10 py-14 md:py-20 bg-cream">
    <div class="max-w-[1180px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
        {steps.map((s) => (
          <div class="rounded-2xl bg-white border border-black/[0.06] p-5 md:p-6">
            <div class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ember-dark mb-2">{s.n}</div>
            <h3 class="text-[18px] md:text-[19px] font-semibold leading-[1.25] tracking-[-0.02em] text-ink m-0">{s.title}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.5] text-ink-2">{s.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-3 md:mt-4 grid grid-cols-2 md:grid-cols-4 rounded-2xl bg-white border border-black/[0.06] overflow-hidden">
        {priceStrip.map((p, i) => (
          <div class:list={['p-4 md:p-5', i % 2 === 1 && 'border-l border-black/[0.06]', i >= 2 && 'border-t md:border-t-0 border-black/[0.06]', i === 2 && 'md:border-l']}>
            <div class="text-[13px] text-ink-2 leading-snug">{p.label}</div>
            <div class="mt-1.5 text-[19px] md:text-[21px] font-semibold tracking-[-0.02em] text-ink">{p.price}</div>
            {p.note && <div class="mt-0.5 text-[11.5px] text-ink-3">{p.note}</div>}
          </div>
        ))}
      </div>
      <div class="mt-6 md:mt-8 rounded-2xl bg-white border-l-[3px] border-ink px-5 py-5 md:px-7 md:py-6">
        <h2 class="text-[17px] md:text-[19px] font-semibold leading-[1.3] tracking-[-0.02em] text-ink m-0">Pourquoi pas une ordonnance express ou une crème de pharmacie&nbsp;?</h2>
        <p class="mt-2 text-[14.5px] md:text-[15.5px] leading-[1.6] text-ink-2 max-w-[860px]">
          Une ordonnance rapide répond à une demande. Ici, le médecin étudie d'abord votre dossier, vos photos et ce que vous avez déjà essayé, puis personnalise votre traitement et vous suit dans la durée. Une crème de pharmacie est la même pour tout le monde : votre plan est construit pour votre peau. Si votre peau demande un examen en cabinet, on vous le dit.
        </p>
        <a href={CTA_HREF} class="mt-4 inline-flex text-[14.5px] font-semibold text-ember-dark no-underline hover:underline">{CTA_LABEL} →</a>
      </div>
    </div>
  </section>

  {/* ── VOUS VOUS RECONNAISSEZ ? verbatims réels (persona Studio Mixt) + photo de situation ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
    <div class="max-w-[1180px] mx-auto grid grid-cols-1 lg:grid-cols-[1.25fr_0.75fr] gap-12 lg:gap-16 items-center">
      <div>
        <FadeInSection client:load>
          <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-5">Vous vous reconnaissez ?</div>
          <h2 class="text-balance text-[32px] md:text-[44px] font-bold leading-[1.08] tracking-[-0.035em] text-ink mb-10">{concern.voices.title}</h2>
        </FadeInSection>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {concern.voices.quotes.map((q, i) => (
            <FadeInSection client:load delay={0.08 * i}>
              <div class="h-full rounded-2xl bg-white border border-black/[0.06] p-5 md:p-6 text-[16px] md:text-[17px] font-medium leading-[1.45] tracking-[-0.01em] text-ink">
                {q}
              </div>
            </FadeInSection>
          ))}
        </div>
        <FadeInSection client:load delay={0.2}>
          <p class="mt-8 text-[17px] md:text-[18px] leading-[1.6] text-ink-2 max-w-[620px]">{concern.voices.outro}</p>
        </FadeInSection>
      </div>
      <FadeInSection client:load delay={0.1} y={20}>
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-blush/30">
          <img src={concern.voices.image} alt={concern.voices.imageAlt} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" style={`object-position: ${concern.voices.imagePosition ?? 'center 30%'};`} />
        </div>
      </FadeInSection>
    </div>
  </section>

  {/* ── CE QUE LE MÉDECIN REGARDE : bloc « dossier » de la plateforme de marque ── */}
  <section id="parcours" class="px-6 md:px-10 py-24 md:py-32 bg-base scroll-mt-20">
    <div class="max-w-[1180px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <FadeInSection client:load>
        <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-5">Ce que le médecin regarde</div>
        <h2 class="text-balance text-[32px] md:text-[44px] font-bold leading-[1.08] tracking-[-0.035em] text-ink mb-6">
          Votre peau a une histoire. Votre traitement doit en tenir compte
        </h2>
        <p class="text-[17px] md:text-[18px] leading-[1.65] text-ink-2 mb-8 max-w-[520px]">
          Vos photos et votre dossier arrivent avant la visio : le médecin sait déjà où vous en êtes. Il choisit les actifs, le dosage et le rythme, puis ajuste avec vous au fil des semaines.
        </p>
        <Button href={CTA_HREF} variant="ember-pill">{CTA_LABEL} →</Button>
      </FadeInSection>
      <DossierTimeline client:visible items={dossier} />
    </div>
  </section>

  {/* ── INTERSTITIEL : aplat de marque + gros plan de vraie peau + CTA blanc ── */}
  <section class="grid grid-cols-1 md:grid-cols-2 text-white" style={`background-color: ${concern.interstitial.color};`}>
    <div class="flex items-center px-6 md:px-10 lg:px-16 py-14 md:py-20 order-2 md:order-1">
      <FadeInSection client:load>
        <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-white/85 mb-6">
          {concern.interstitial.eyebrow}
        </div>
        <p class="text-balance text-[32px] md:text-[42px] lg:text-[50px] font-bold leading-[1.05] tracking-[-0.04em] text-white mb-9 max-w-[520px]">
          {concern.interstitial.slogan}
        </p>
        <Button href={CTA_HREF} variant="white">{CTA_LABEL} →</Button>
      </FadeInSection>
    </div>
    <div class="relative h-[70vw] max-h-[420px] md:h-auto md:max-h-none md:min-h-[440px] order-1 md:order-2 overflow-hidden">
      <img
        src={concern.interstitial.image}
        alt={concern.interstitial.imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${concern.interstitial.imagePosition ?? 'center'};`}
        loading="lazy"
      />
    </div>
  </section>

  {/* ── MECHANISM + ACTIFS ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-base">
    <div class="max-w-[1180px] mx-auto">
      <FadeInSection client:load>
        <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-violet mb-8">
          <span class="inline-block h-[2px] w-12 bg-violet/80"></span>
          La science dermatologique
        </div>
      </FadeInSection>

      <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 items-start">
        {/* Photo : préparation en pharmacie */}
        <FadeInSection client:load delay={0.1} y={20}>
          <div class="relative aspect-[3/2] lg:aspect-[4/5] overflow-hidden rounded-2xl bg-blush/30 shadow-[0_20px_60px_-22px_rgba(50,25,34,0.32)] lg:sticky lg:top-28">
            <img
              src={concern.formulaImage}
              alt="Préparation magistrale prescrite par le médecin, préparée en pharmacie"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute left-5 top-5 z-[5] rounded-[6px] bg-deep/95 backdrop-blur px-3 py-1.5 font-mono text-[10px] font-semibold tracking-[0.18em] uppercase text-white">
              Préparé en pharmacie
            </div>
          </div>
        </FadeInSection>

        {/* Pédagogie + actifs */}
        <div>
          <FadeInSection client:load>
            <p class="text-[22px] md:text-[28px] font-medium leading-[1.3] tracking-[-0.02em] text-ink mb-3">
              {concern.mechanism.lede}
            </p>
            <p class="text-[16px] md:text-[17px] leading-[1.7] text-ink-2 mb-10">
              {concern.mechanism.body}
            </p>
          </FadeInSection>

          <FadeInSection client:load delay={0.1}>
            <div class="rounded-[16px] bg-base border border-black/[0.06] shadow-[0_12px_44px_-24px_rgba(50,25,34,0.30)] p-6 md:p-8">
              <p class="text-[13.5px] md:text-[14px] text-ink-2 leading-[1.5] mb-5">
                Les actifs utilisés en dermatologie sur cette condition.
              </p>
              <div class="hidden sm:grid sm:grid-cols-[200px_1fr] gap-x-8 pb-2.5 border-b border-black/[0.12]">
                <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-ink-3 font-medium">Actif</span>
                <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-ink-3 font-medium">Effet</span>
              </div>
              {concern.mechanism.actifs.map((a, i) => (
                <div class={`grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-x-8 gap-y-1 py-3.5 items-baseline ${i > 0 ? 'border-t border-black/[0.07]' : ''}`}>
                  <span class="text-[14px] sm:text-[14.5px] font-semibold text-ink tracking-[-0.005em]">{a.name}</span>
                  <p class="text-[13.5px] leading-[1.5] text-ink-2 m-0">
                    <strong class="font-semibold text-ink">{a.bold}</strong>{a.rest ? ' ' + a.rest : (/[.!?]$/.test(a.bold) ? '' : '.')}
                  </p>
                </div>
              ))}
              <div class="mt-4 pt-3.5 border-t border-black/[0.07] text-[12.5px] text-ink-3 leading-[1.55]">
                {concern.mechanism.footer} Ces actifs ne sont pas disponibles en cosmétique : ils sont prescrits et préparés en pharmacie sur ordonnance médicale.
              </div>
            </div>
          </FadeInSection>
        </div>
      </div>
    </div>
  </section>

  <V3Dermatologue />
  <EquipeMedicale />

  {/* ── PROOF ── */}
  {concern.proof && (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
      <div class="max-w-[1100px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-jade-deep mb-5">
            <span class="inline-block h-[2px] w-12 bg-jade-deep/80"></span>
            Résultats réels
          </div>
          <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-ink mb-12 md:mb-14 max-w-[680px]">
            Elle a suivi le parcours <span class="italic-serif whitespace-nowrap">avant vous.</span>
          </h2>
        </FadeInSection>
        <div class="grid grid-cols-1 lg:grid-cols-[55%_45%] gap-10 lg:gap-14 items-center">
          <BeforeAfterReveal
            client:load
            before={concern.proof.before}
            after={concern.proof.after}
            afterLabel={concern.proof.afterLabel}
          />
          <FadeInSection client:load delay={0.15}>
            <h3 class="text-[22px] md:text-[24px] font-semibold text-ink mb-1 tracking-[-0.02em]">{concern.proof.name}</h3>
            <div class="text-[13px] uppercase tracking-[0.12em] text-ink-3 font-semibold mb-6">{concern.proof.meta}</div>
            <blockquote class="italic-serif text-[24px] md:text-[30px] leading-[1.45] text-ink mb-6 pb-6 border-b border-black/[0.08]">
              « {concern.proof.quote} »
            </blockquote>
            <p class="text-[14.5px] text-ink-2 leading-relaxed max-w-[480px]">{concern.proof.context}</p>
            <p class="mt-4 text-[11px] text-ink-3 italic leading-snug">{concern.proof.legal}</p>
            <div class="mt-8">
              <Button href={CTA_HREF} variant="dark">{CTA_LABEL} →</Button>
            </div>
          </FadeInSection>
        </div>
      </div>
    </section>
  )}

  <MotFondatrice ctaHref={CTA_HREF} ctaLabel={CTA_LABEL} />

  {/* ── EXPECTATIONS (optional) ── */}
  {concern.expectations && (
    <section class="px-6 md:px-10 py-24 md:py-32 bg-cream">
      <div class="max-w-[1100px] mx-auto">
        <FadeInSection client:load>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-violet mb-5">
            <span class="inline-block h-[2px] w-12 bg-violet/80"></span>
            Le rythme du traitement
          </div>
          <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.12] tracking-[-0.035em] text-ink mb-3 max-w-[760px]">
            {concern.expectations.title}{' '}
            <span class="italic-serif whitespace-nowrap">{concern.expectations.highlight}</span>
          </h2>
          {concern.expectations.intro && (
            <p class="text-[16px] md:text-[17px] leading-[1.7] text-ink-2 max-w-[620px] mb-12">
              {concern.expectations.intro}
            </p>
          )}
        </FadeInSection>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
          {concern.expectations.steps.map((s, i) => (
            <FadeInSection client:load delay={i * 0.1} y={18}>
              <div class="border-t border-black/[0.12] pt-5">
                <div class="font-mono text-[12px] tracking-[0.14em] uppercase text-ember-deep mb-3">{s.when}</div>
                <p class="text-[15px] leading-[1.6] text-rich">{s.body}</p>
              </div>
            </FadeInSection>
          ))}
        </div>
        {concern.expectations.footnote && (
          <FadeInSection client:load delay={0.15}>
            <p class="mt-12 pt-8 border-t border-black/[0.08] text-[13.5px] text-ink-2 italic leading-relaxed max-w-[720px]">
              {concern.expectations.footnote}
            </p>
          </FadeInSection>
        )}
      </div>
    </section>
  )}

  {/* ── PRICING ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-base">
    <div class="max-w-[1200px] mx-auto">
      <FadeInSection client:load>
        <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-center max-w-[820px] mx-auto mb-4 text-ink">
          Ce que vous payez, <span class="italic-serif whitespace-nowrap">et à qui.</span>
        </h2>
        <p class="text-center text-[15px] md:text-[16px] text-ink-2 max-w-[620px] mx-auto leading-relaxed">
          La transparence, dès le premier jour. Les 49 € de la consultation rémunèrent intégralement le médecin. Mixt ne prélève aucune commission. Les 49 € ne sont débités qu'une fois la téléconsultation effectuée.
        </p>
      </FadeInSection>
      <FadeInSection client:load delay={0.1}>
        <div class="max-w-[860px] mx-auto mt-14 overflow-hidden rounded-[12px] border border-black/[0.08] bg-base">
          {ledger.map((row, i) => (
            <div class={`flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 px-5 md:px-7 py-5 ${i < ledger.length - 1 ? 'border-b border-black/[0.07]' : ''} ${row.highlight ? 'bg-cream/60' : ''}`}>
              <div class="sm:w-[230px] shrink-0">
                <div class="text-[15px] font-semibold text-ink">{row.label}</div>
                <div class="text-[12px] text-ink-3 mt-0.5">{row.who}</div>
              </div>
              <div class="flex-1 text-[13.5px] text-ink-2 leading-snug order-3 sm:order-2">{row.get}</div>
              <div class="order-2 sm:order-3 sm:text-right">
              <div class={`font-semibold tracking-[-0.02em] ${row.highlight ? 'text-[28px] text-ink' : 'text-[20px] text-ink'}`}>{row.price}</div>
              {row.note && <div class="text-[11.5px] text-ink-3 mt-0.5">{row.note}</div>}
            </div>
            </div>
          ))}
        </div>
      </FadeInSection>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="px-6 md:px-10 pt-24 md:pt-32 pb-16 md:pb-24 bg-cream">
    <div class="max-w-[1200px] mx-auto">
      <FadeInSection client:load>
        <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-center mb-12 md:mb-16 text-ink">
          {concern.chip}, <span class="italic-serif whitespace-nowrap">vos questions.</span>
        </h2>
      </FadeInSection>
      <div class="max-w-[760px] mx-auto">
        <Accordion client:load items={allFaq} />
      </div>
    </div>
  </section>

  {/* ── RELATED ── */}
  {concern.related.length > 0 && (
    <section class="px-6 md:px-10 pb-24 md:pb-28 bg-cream">
      <div class="max-w-[860px] mx-auto">
        <FadeInSection client:load>
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-3 mb-6 text-center">Autres préoccupations</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {concern.related.map((r) => (
              <a href={r.href} class="group block rounded-2xl border border-black/[0.08] bg-base px-6 py-5 no-underline transition-colors hover:border-ink/25">
                <div class="flex items-center justify-between">
                  <span class="text-[16px] font-semibold text-ink">{r.label}</span>
                  <span class="text-ember transition-transform group-hover:translate-x-[3px]" aria-hidden>→</span>
                </div>
                <p class="text-[13.5px] text-ink-2 leading-snug mt-1.5">{r.teaser}</p>
              </a>
            ))}
          </div>
        </FadeInSection>
      </div>
    </section>
  )}

  {/* ── FINAL CTA ── */}
  <section class="relative overflow-hidden px-6 md:px-10 py-24 md:py-32 bg-deep text-white text-center">
    <div class="relative z-[2] max-w-[780px] mx-auto">
      <FadeInSection client:load>
        <h2 class="text-balance text-[34px] md:text-[46px] font-medium leading-[1.12] tracking-[-0.035em] text-white mb-6 max-w-[680px] mx-auto">
          {concern.chip} : et si on s'en occupait <span class="italic-serif whitespace-nowrap">vraiment ?</span>
        </h2>
        <p class="text-[16px] md:text-[18px] leading-[1.65] text-white/60 max-w-[520px] mx-auto mb-9">
          Répondez à quelques questions et ajoutez vos photos : c'est gratuit. Un médecin vous reçoit en visio sous 7 jours si vous réservez.
        </p>
        <Button href={CTA_HREF} variant="white">{CTA_LABEL} →</Button>
        <div class="mt-5 text-[13px] text-white/60">
          Bilan gratuit et sans engagement. Consultation à 49 €, seulement si vous la réservez.
        </div>
      </FadeInSection>
    </div>
  </section>

  <Footer />
  <MobileStickyCta />
</BaseLayout>
