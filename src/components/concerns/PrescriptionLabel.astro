---
/**
 * Étiquette d'ordonnance : reprise typographique de l'étiquette réelle collée
 * sur les préparations magistrales (pharmacie préparatoire).
 *
 * C'est l'objet le plus crédible de Mixt : des actifs nommés, des pourcentages
 * réels très au-dessus des plafonds cosmétiques, et la mention "uniquement sur
 * ordonnance". Un concurrent qui vend un cosmétique ne peut pas le montrer.
 * On ne redessine pas l'étiquette réglementaire, on en fait un écho graphique.
 */
interface Props {
  /** Nom de la formule, ex. "PIGMENT CONTROLE BOOST". */
  formula: string;
  /** Composition : actif + concentration. */
  lines: { name: string; pct: string }[];
  /** Excipient / base. */
  base?: string;
  /** Mention sous la composition. */
  note?: string;
}
const { formula, lines, base, note } = Astro.props;
---

<div class="relative rounded-[14px] bg-base border border-black/[0.10] overflow-hidden shadow-[0_14px_44px_-26px_rgba(54,24,34,0.35)]">
  <div class="h-[6px] bg-jade-deep"></div>

  <div class="px-6 md:px-8 pt-6 pb-5">
    <div class="flex items-baseline justify-between gap-4 pb-4 mb-5 border-b border-black/[0.12]">
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-3">Préparation magistrale</span>
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">Voie cutanée</span>
    </div>

    {lines.map((l) => (
      <div class="flex items-baseline justify-between gap-5 py-[7px] border-b border-dashed border-black/[0.10]">
        <span class="font-mono text-[12.5px] md:text-[13px] uppercase tracking-[0.05em] text-ink">{l.name}</span>
        <span class="font-mono text-[12.5px] md:text-[13px] font-semibold text-ember-deep tabular-nums shrink-0">{l.pct}</span>
      </div>
    ))}

    {base && (
      <div class="flex items-baseline justify-between gap-5 py-[7px]">
        <span class="font-mono text-[12.5px] md:text-[13px] uppercase tracking-[0.05em] text-ink-2">{base}</span>
        <span class="font-mono text-[12px] text-ink-3 shrink-0">excipient</span>
      </div>
    )}

    <div class="mt-5 pt-4 border-t border-black/[0.12]">
      <div class="font-mono text-[13px] md:text-[14px] uppercase tracking-[0.12em] text-ink font-semibold">{formula}</div>
    </div>
  </div>

  <div class="px-6 md:px-8 py-3 bg-ember/10 border-t border-ember/25">
    <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-ember-deep font-semibold">
      Uniquement sur ordonnance
    </span>
  </div>

  {note && (
    <div class="px-6 md:px-8 py-3 border-t border-black/[0.08]">
      <p class="text-[11.5px] leading-[1.5] text-ink-3 m-0">{note}</p>
    </div>
  )}
</div>
