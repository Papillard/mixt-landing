---
// Rangée discrète « Pour aller plus loin » (champ optionnel `articles`) : 3 liens max vers le blog,
// vignette carrée, titre, flèche. Volontairement sobre pour ne pas détourner de la conversion.
import { getCollection } from 'astro:content';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const nbsp = (t: string) => t.replace(/ ([:?!;])/g, ' $1');
const items = slugs
  .map((slug) => posts.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .slice(0, 3);
---

{items.length > 0 && (
  <nav aria-label="Pour aller plus loin" class="max-w-[1100px] mx-auto mb-20 md:mb-24">
    <p class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink-3 mb-4">Pour aller plus loin</p>
    <ul class="list-none m-0 p-0 grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
      {items.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`} class="group flex items-center gap-4 h-full rounded-[14px] border border-black/[0.08] p-2.5 pr-4 no-underline transition-colors hover:border-ink/25">
            {p.data.heroImage ? (
              <img src={p.data.heroImage} alt="" loading="lazy" decoding="async" width="64" height="64" class="h-16 w-16 shrink-0 rounded-[10px] object-cover" />
            ) : (
              <span class="h-16 w-16 shrink-0 rounded-[10px] bg-blush/40" aria-hidden="true"></span>
            )}
            <span class="flex-1 text-[14.5px] font-semibold leading-[1.3] tracking-[-0.01em] text-ink">{nbsp(p.data.h1)}</span>
            <span class="text-ember transition-transform group-hover:translate-x-[3px]" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
