---
import FadeInSection from '../motion/FadeInSection.tsx';

// Verbatims réels, avis 5★ publiés sur Trustpilot (juillet 2026).
const reviews = [
  {
    quote: "J'ai enfin l'impression d'être suivie par des gens qui regardent vraiment, réagissent vite et savent exactement quoi faire.",
    name: 'Amandine B.',
    tag: 'Rosacée',
  },
  {
    quote: "J'ai l'impression d'avoir appris plus sur ma peau en quelques mois qu'en des années à tester des produits toute seule.",
    name: 'Marie G.',
    tag: 'Masque de grossesse',
  },
  {
    quote: "L'équipe Mixt est super disponible.",
    name: 'Sadie B.',
    tag: 'Formule sur-mesure',
  },
];
---

<section class="relative overflow-hidden px-6 md:px-10 py-14 md:py-20 bg-deep text-white">
  {/* Texture de marque plein cadre : bulles ambrées sur fond sombre, assez foncées pour porter le texte blanc sans voile. */}
  <img src="/images/real/texture-ambre-bulles-01.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover object-[center_55%]" />
  <div class="relative max-w-[1200px] mx-auto">
    <FadeInSection client:load>
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-8 md:mb-10">
        <h2 class="text-[44px] md:text-[64px] font-bold leading-[1] tracking-[-0.045em] text-white m-0 whitespace-nowrap [text-shadow:0_2px_16px_rgba(0,0,0,0.45)]">
          Leurs mots
        </h2>
        <div class="shrink-0 inline-flex items-center gap-2.5 rounded-full bg-base pl-2.5 pr-4 py-2">
          <span class="inline-flex items-center gap-[3px]">
            {[0, 1, 2, 3, 4].map(() => (
              <span class="inline-flex items-center justify-center w-[18px] h-[18px] rounded-[3px]" style="background:#00b67a">
                <span class="text-white text-[11px] leading-none">★</span>
              </span>
            ))}
          </span>
          <span class="text-[13.5px] text-ink"><strong class="font-semibold">Trustpilot</strong> · avis vérifiés</span>
        </div>
      </div>
    </FadeInSection>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {reviews.map((r, i) => (
        <FadeInSection client:load delay={0.08 + i * 0.06} className="h-full">
          <figure class="h-full flex flex-col rounded-2xl bg-base border border-black/[0.06] p-6">
            <div class="mb-4">
              <span class="text-ember text-[19px] tracking-[0.1em]" aria-label="Noté 5 sur 5">★★★★★</span>
            </div>
            <blockquote class="italic-serif text-[21px] md:text-[23px] leading-[1.42] text-ink flex-1">
              « {r.quote} »
            </blockquote>
            <figcaption class="mt-5 pt-4 border-t border-black/[0.08] flex items-center justify-between gap-2">
              <span class="text-[14px] font-semibold text-ink">{r.name}</span>
              <span class="rounded-[6px] bg-deep px-2.5 py-1 text-[9.5px] font-semibold tracking-[0.16em] uppercase text-white">{r.tag}</span>
            </figcaption>
          </figure>
        </FadeInSection>
      ))}
    </div>

  </div>
</section>
