---
import Accordion from '../motion/Accordion.tsx';
import Button from '../Button.astro';
import FadeInSection from '../motion/FadeInSection.tsx';

const startHref = 'https://app.mixt.care/start';
const whatsappHref =
  'https://wa.me/33756948494?text=' +
  encodeURIComponent("Bonjour Laetitia, j'aimerais échanger à propos de Mixt et de ma peau.");

const faq = [
  {
    q: "Combien ça coûte, et à qui ?",
    a: [
      {
        heading: 'Le bilan en ligne : gratuit',
        body: "Vous le faites en ligne et repartez avec un dossier dermatologique structuré, à vous.",
      },
      {
        heading: 'La première consultation : 49 €',
        body: "Ces 49 € rémunèrent intégralement le médecin. Mixt ne prélève aucune commission. Le bilan en ligne, le dossier structuré, la coordination et le suivi par l'équipe Mixt après la consultation vous sont offerts. Les 49 € ne sont débités qu'une fois la téléconsultation effectuée.",
      },
      {
        heading: 'La formule magistrale, si prescrite : 30 à 60 € (prix indicatif)',
        body: "Facturée par votre pharmacie. Prise en charge éventuelle selon votre couverture santé.",
      },
      {
        heading: 'Le suivi : inclus',
        body: "Après la consultation, le suivi par l'équipe Mixt est inclus, sans surcoût : questions pratiques, journal photo, conseils. Aucun abonnement.",
      },
    ],
  },
  {
    q: "Le bilan est-il vraiment gratuit ?",
    a: "Oui. Vous pouvez faire votre bilan en ligne et obtenir votre dossier dermatologique structuré sans rien payer. Vous ne réglez les 49 € que si vous choisissez de réserver votre téléconsultation à l'issue du bilan.",
  },
  {
    q: 'Qui est le médecin ?',
    a: "Un médecin généraliste diplômé, inscrit à l'Ordre des Médecins, avec un RPPS vérifiable, expérimenté dans la prise en charge des problèmes de peau. Vous le rencontrez en téléconsultation, et il construit votre plan de traitement personnalisé.",
  },
  {
    q: 'Comment fonctionne la consultation médicale ?',
    a: "C'est une consultation préparée, centrée sur votre peau. Votre médecin arrive avec tout votre dossier déjà en main : il ne perd pas 15 minutes à le reconstituer. Il s'appuie sur notre comité de dermatologues pour les cas qui le nécessitent, et vous suit dans la durée. Résultat : une consultation dédiée à votre plan de traitement, sans attendre des mois pour consulter.",
  },
  {
    q: 'Mes données et mes photos sont-elles protégées ?',
    a: "Oui. Vos données et vos photos sont hébergées en France, dans un environnement certifié HDS (Hébergeur de Données de Santé), et soumises au secret médical. Leur accès est sécurisé et réservé aux personnes habilitées, dans le cadre de votre prise en charge.",
  },
  {
    q: "Y a-t-il un abonnement ?",
    a: "Non, aucun abonnement. La téléconsultation se suffit à elle-même : vous repartez avec votre plan de traitement, c'est à vous. Et après la consultation, le suivi par l'équipe Mixt est inclus, sans surcoût.",
  },
  {
    q: "En quoi consiste le suivi inclus ?",
    a: "Après la consultation, l'équipe Mixt vous accompagne entre les consultations, tient votre journal photo et répond à vos questions pratiques. C'est un accompagnement, inclus et sans surcoût, pas un acte médical ni un diagnostic.",
  },
  {
    q: "Aurai-je forcément une ordonnance ?",
    a: "La prescription relève de la seule décision du médecin. Selon votre cas, il peut prescrire une formule magistrale sur mesure, un traitement dermatologique classique, ou recommander une approche essentiellement cosmétique. Dans tous les cas, vous repartez avec un avis médical personnalisé et un plan clair pour votre peau.",
  },
];
---

<section class="px-6 md:px-10 pt-24 md:pt-32 pb-16 md:pb-24 bg-base">
  <div class="max-w-[1200px] mx-auto">
    <FadeInSection client:load>
      <h2 class="text-[40px] md:text-[52px] font-medium leading-[1.06] tracking-[-0.035em] text-center mb-12 md:mb-16 text-ink">
        Questions <span class="italic-serif whitespace-nowrap">fréquentes</span>
      </h2>
    </FadeInSection>

    <div class="max-w-[760px] mx-auto">
      <Accordion client:load items={faq} />
    </div>

    <FadeInSection client:load>
      <div class="max-w-[760px] mx-auto mt-12 md:mt-14 text-center">
        <p class="text-[18px] md:text-[20px] font-medium text-ink mb-5">
          Encore des questions ?
        </p>
        <Button href={whatsappHref} variant="dark">Nous parler 20 min →</Button>
        <p class="mt-4 text-[13px] text-ink-3">
          Ou démarrez votre diagnostic, gratuit et sans engagement.
        </p>
      </div>
    </FadeInSection>
  </div>
</section>

<section class="relative overflow-hidden px-6 md:px-10 py-24 md:py-32 bg-deep text-white text-center">
  <div class="relative z-[2] max-w-[780px] mx-auto">
    <FadeInSection client:load>
      <h2 class="text-[36px] md:text-[46px] font-medium leading-[1.12] tracking-[-0.035em] text-white mb-10 max-w-[780px] mx-auto">
        Votre peau mérite mieux<br class="hidden md:inline" /> <span class="italic-serif md:whitespace-nowrap">qu'une ordonnance sans suivi</span>
      </h2>
      <Button href={startHref} variant="white">Démarrer ma consultation →</Button>
      <div class="mt-5 text-[13px] text-white/60">
        Gratuit · sans engagement. Vous ne payez que si vous réservez votre téléconsultation.
      </div>
    </FadeInSection>
  </div>
</section>
