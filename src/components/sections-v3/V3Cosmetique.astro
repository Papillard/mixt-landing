---
import FadeInSection from '../motion/FadeInSection.tsx';
import Button from '../Button.astro';

// Objection prix des crèmes. Format Skin+Me : six lignes, une par différence
// réelle. Arguments réglementaires et médicaux uniquement, pas de promesse
// marketing : concentration d'actifs, diagnostic, ajustement, suivi, statut
// remboursable. Chaque ligne doit tenir devant un dermatologue.
// Chaque case tient sur deux lignes, des deux côtés (retour à la ligne forcé sur desktop).
const rows = [
  { left: ['Des actifs', 'faiblement dosés.'], right: ['Actifs dermatologiques,', 'dosages personnalisés.'] },
  { left: ['Choisis en rayon,', 'ou au hasard.'], right: ['Choisis par votre médecin,', 'après un diagnostic.'] },
  { left: ['Toner, sérum, crème :', "les produits s'empilent."], right: ['Vos actifs traitants réunis', 'dans un seul tube.'] },
  { left: ['Conservateurs, parfums', 'et ingrédients en plus.'], right: ['Une formule simple : vos actifs,', "une base, rien d'autre."] },
  { left: ['Si ça irrite ou ne marche pas,', 'vous changez de marque.'], right: ['Votre médecin ajuste le dosage', 'ou change la formule.'] },
  { left: ['3 ou 4 produits à 25-50 € pièce,', 'à racheter sans cesse.'], right: ['Un tube à 30-60 € (indicatif),', 'si prescrite, pour 2 à 3 mois.'] },
];
---

<section id="cosmetique" class="bg-base px-4 sm:px-6 md:px-10 py-24 md:py-32">
  <div class="max-w-[1080px] mx-auto">

    {/* ── En-tête deux colonnes : titre à gauche, photo à droite ── */}
    <FadeInSection client:load>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,440px)] gap-8 lg:gap-14 items-center">
        <div>
          <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-ember-deep mb-5">
            <span class="inline-block h-[2px] w-12 bg-ember-deep/70"></span>
            Ce que ça remplace
          </div>
          <h2 class="text-[40px] md:text-[52px] font-bold leading-[1.06] tracking-[-0.035em] text-ink max-w-[560px] m-0">
            Pourquoi ce n'est pas<br class="hidden sm:block" /> une crème de plus
          </h2>
        </div>
        <div class="overflow-hidden rounded-[12px] bg-cream">
          <img
            src="/images/real/produit-tube-froisse-01.webp"
            alt="Tube de préparation magistrale Mixt, utilisé jusqu'au bout"
            loading="lazy"
            decoding="async"
            class="block w-full aspect-[3/2] object-cover object-[center_45%]"
          />
        </div>
      </div>
    </FadeInSection>

    {/* ── Le tableau ───────────────────────────────────────── */}
    {/* Deux colonnes à toutes les tailles : sur mobile on réduit la typo,
        on ne casse jamais la comparaison en lignes empilées. */}
    <div class="mt-14 md:mt-20">

      {/* En-têtes de colonnes, alignés sur la grille des lignes */}
      <FadeInSection client:load>
        <div class="grid grid-cols-[1fr_auto_1fr] items-end pb-4 md:pb-6">
          <div class="px-1 md:pl-20 text-center md:text-left">
            <span class="font-mono text-[10px] md:text-[12px] font-medium uppercase tracking-[0.12em] md:tracking-[0.2em] text-ink-3">
              Routine cosmétique
            </span>
          </div>
          <div class="px-2 md:px-6">
            <span class="block h-9 w-9 md:h-11 md:w-11"></span>
          </div>
          <div class="px-1 md:pl-20 text-center md:text-left">
            <span class="font-serif text-[24px] md:text-[34px] font-bold leading-none tracking-[-0.045em] text-ink">mixt</span>
          </div>
        </div>
      </FadeInSection>

      {/* Surface unique, lignes séparées par un filet : pas de bandes alternées */}
      <div class="relative rounded-[16px] overflow-hidden border border-black/[0.06]" style="background: linear-gradient(to right, #EFF1F2 50%, #FFFFFF 50%);">
        {/* Deux aplats nets côte à côte (pas de fondu) : gris pour la routine, blanc pour Mixt. */}
        <div class="absolute inset-y-0 left-1/2 w-px bg-black/[0.07] -translate-x-1/2 pointer-events-none"></div>

        {rows.map((r, i) => (
          <div class={`relative grid grid-cols-[1fr_auto_1fr] items-center ${i > 0 ? 'border-t border-black/[0.06]' : ''}`}>
            <div class="pl-3 pr-1 md:pl-20 md:pr-12 py-6 md:py-11">
              <p class="m-0 flex flex-col md:flex-row items-center md:items-start gap-2 md:gap-3 text-center md:text-left text-[13px] md:text-[17px] leading-[1.45] md:leading-[1.6] text-ink-2 md:max-w-[380px] md:mr-auto">
                <span class="mt-[2px] inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-danger/10 text-danger" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" class="h-[11px] w-[11px]"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </span>
                <span>{r.left[0]}<br class="hidden md:inline" /> {r.left[1]}</span>
              </p>
            </div>
            {/* Pastille « vs », posée sur la colonne vertébrale */}
            <div class="px-2 md:px-6 flex justify-center">
              <span class="flex h-9 w-9 md:h-11 md:w-11 shrink-0 items-center justify-center rounded-full bg-white ring-1 ring-black/[0.06] shadow-[0_2px_10px_-2px_rgba(0,0,0,0.12)] font-mono text-[10px] md:text-[11px] font-semibold uppercase tracking-[0.1em] md:tracking-[0.12em] text-ink">
                vs
              </span>
            </div>
            <div class="pr-3 pl-1 md:pr-12 md:pl-20 py-6 md:py-11">
              <p class="m-0 flex flex-col md:flex-row items-center md:items-start gap-2 md:gap-3 text-center md:text-left text-[13.5px] md:text-[17.5px] leading-[1.45] md:leading-[1.6] font-semibold text-ink md:max-w-[380px] md:mr-auto">
                <span class="mt-[2px] inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-jade/15 text-jade-deep" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="h-[12px] w-[12px]"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span>{r.right[0]}<br class="hidden md:inline" /> {r.right[1]}</span>
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>

    {/* ── Pied : la nuance prix, puis le CTA ───────────────── */}
    <FadeInSection client:load delay={0.1}>
      <div class="mt-12 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8 border-t border-black/[0.08] pt-8">
        <p class="m-0 text-[15px] leading-[1.55] text-ink-2 max-w-[620px]">
          On cherche à réduire le nombre de produits, pas à en ajouter un. La formule regroupe
          les actifs traitants dans un seul tube. Le nettoyant et l'écran solaire, eux, restent
          nécessaires.
        </p>
        <div class="shrink-0">
          <Button href="https://app.mixt.care/start">Démarrer mon bilan gratuit →</Button>
        </div>
      </div>
    </FadeInSection>

  </div>
</section>
