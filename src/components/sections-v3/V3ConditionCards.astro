---
// Navigation vers les pages condition : vraie peau + aplat de marque (règle du brand book), juste sous le hero.
const cards = [
  { href: '/acne', label: 'Acné adulte', hint: 'Boutons qui reviennent', img: '/images/real/patiente-laetitia-acne-portrait-trois-quarts-01.webp', pos: 'center 30%', color: '#481B27' },
  { href: '/rosacee', label: 'Rosacée', hint: 'Rougeurs, peau qui chauffe', img: '/images/real/patiente-elise-rosacee-portrait-trois-quarts-01.webp', pos: 'center 30%', color: '#292627' },
  { href: '/taches', label: 'Taches et mélasma', hint: 'Masque de grossesse, taches brunes', img: '/images/real/patiente-leonixia-taches-portrait-sourire-01.webp', pos: 'center 45%', color: '#321E2D' },
];
---

<section class="bg-base pb-16 md:pb-24">
  <div class="max-w-[1200px] mx-auto px-6 md:px-10">
    <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-4 md:mb-5">
      Quel est votre problème de peau ?
    </div>
    {/* Mobile : une carte par ligne, vignette photo + titre. Desktop : 3 grandes cartes. */}
    <div class="flex flex-col md:grid md:grid-cols-3 gap-2.5 md:gap-4">
      {cards.map((c) => (
        <a
          href={c.href}
          class="group flex md:flex-col items-stretch overflow-hidden rounded-2xl no-underline"
          style={`background-color: ${c.color};`}
        >
          <div class="relative w-[84px] shrink-0 md:w-auto aspect-square md:aspect-[4/5] overflow-hidden bg-cream">
            <img
              src={c.img}
              alt={`${c.label} : ${c.hint}`}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              style={`object-position: ${c.pos};`}
            />
          </div>
          <div class="flex flex-1 items-center justify-between gap-3 px-4 md:px-5 py-3 md:py-4 text-white">
            <div>
              <div class="text-[17px] md:text-[19px] font-bold tracking-[-0.025em] leading-tight">{c.label}</div>
              <div class="text-[12.5px] text-white/70 mt-0.5">{c.hint}</div>
            </div>
            <span class="text-[18px] transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
