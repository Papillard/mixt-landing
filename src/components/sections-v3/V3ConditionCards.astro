---
// Navigation vers les pages condition : 4 cartes texture + libellé, juste sous le hero.
// Mobile : défilement horizontal.
const cards = [
  { href: '/acne', label: 'Acné adulte', hint: 'Boutons qui reviennent', img: '/images/real/texture-rouge-creme-nacree-01.webp' },
  { href: '/rosacee', label: 'Rosacée', hint: 'Rougeurs, peau qui chauffe', img: '/images/real/texture-rouge-goutte-gel-01.webp' },
  { href: '/melasma', label: 'Mélasma', hint: 'Masque de grossesse', img: '/images/real/texture-ambre-bulles-01.webp' },
  { href: '/hyperpigmentation', label: 'Taches brunes', hint: "Marques d'acné, soleil", img: '/images/real/texture-brun-nature-morte-bois-01.webp' },
];
---

<section class="bg-base pb-16 md:pb-24">
  <div class="max-w-[1200px] mx-auto px-6 md:px-10">
    <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-5">
      Quel est votre problème de peau ?
    </div>
  </div>
  <div class="max-w-[1200px] mx-auto md:px-10">
    <div class="flex md:grid md:grid-cols-4 gap-3 md:gap-4 overflow-x-auto snap-x snap-mandatory px-6 md:px-0 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {cards.map((c) => (
        <a
          href={c.href}
          class="group relative shrink-0 w-[62vw] max-w-[260px] md:w-auto md:max-w-none aspect-[4/5] overflow-hidden rounded-2xl bg-deep snap-start no-underline"
        >
          <img
            src={c.img}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          />
          <div class="absolute left-3 right-3 bottom-3 rounded-xl bg-white px-4 py-3 flex items-center justify-between gap-3">
            <div>
              <div class="text-[16px] md:text-[17px] font-bold tracking-[-0.02em] text-ink leading-tight">{c.label}</div>
              <div class="text-[12.5px] text-ink-2 mt-0.5">{c.hint}</div>
            </div>
            <span class="text-ink text-[18px] transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
