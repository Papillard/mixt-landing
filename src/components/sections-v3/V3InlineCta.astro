---
import Button from '../Button.astro';
import FadeInSection from '../motion/FadeInSection.tsx';

const startHref = 'https://app.mixt.care/start';
---

<section class="px-6 md:px-10 py-20 md:py-28 bg-base text-center">
  <div class="max-w-[680px] mx-auto">
    <FadeInSection client:load>
      <h2 class="text-[28px] md:text-[38px] font-medium leading-[1.14] tracking-[-0.03em] text-ink mb-7 md:mb-8">
        Prêt à traiter votre peau <span class="italic-serif">pour de vrai</span> ?
      </h2>
      <Button href={startHref} variant="ember-pill">Démarrer ma consultation →</Button>
      <p class="mt-5 text-[13px] text-ink-3 max-w-[420px] mx-auto leading-relaxed">
        Gratuit, vous ne payez que si vous réservez votre téléconsultation.
      </p>
    </FadeInSection>
  </div>
</section>
