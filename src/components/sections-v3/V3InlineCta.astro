---
import Button from '../Button.astro';
import FadeInSection from '../motion/FadeInSection.tsx';

const startHref = 'https://app.mixt.care/start';
---

<section class="grid grid-cols-1 md:grid-cols-2 text-white" style="background-color:#321E2D">
  <div class="flex items-center px-6 md:px-10 lg:px-16 py-14 md:py-20 order-2 md:order-1">
    <FadeInSection client:load>
      <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-white/80 mb-6">Bilan gratuit en 5 minutes</div>
      <h2 class="text-balance text-[32px] md:text-[42px] lg:text-[50px] font-bold leading-[1.05] tracking-[-0.04em] text-white mb-9 max-w-[520px]">
        Le bon traitement commence par un avis médical
      </h2>
      <Button href={startHref} variant="white">Démarrer ma consultation →</Button>
      <p class="mt-5 text-[13px] text-white/60 max-w-[420px] leading-relaxed">
        Gratuit, vous ne payez que si vous réservez votre téléconsultation.
      </p>
    </FadeInSection>
  </div>
  <div class="relative h-[70vw] max-h-[420px] md:h-auto md:max-h-none md:min-h-[460px] order-1 md:order-2 overflow-hidden">
    <img src="/images/real/produit-tube-main-fond-brun-01.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover object-[center_8%]" />
  </div>
</section>
