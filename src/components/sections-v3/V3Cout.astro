---
import FadeInSection from '../motion/FadeInSection.tsx';

// Montants de gauche : ordres de grandeur du marché cosmétique, à valider.
// Montants de droite : tarifs Mixt réels, alignés sur la grille tarifaire.
const routine = [
  { label: 'Sérum actif', price: '45 €' },
  { label: 'Crème traitante', price: '38 €' },
  { label: 'Soin anti-taches ciblé', price: '52 €' },
  { label: 'Écran solaire teinté', price: '25 €' },
];

const mixt = [
  { label: 'Une formule magistrale', price: '30-60 €', note: 'Un tube tient deux à trois mois' },
  { label: 'La consultation', price: '49 €', note: "Une seule fois, à l'entrée du parcours" },
  { label: 'Le suivi', price: 'Inclus', note: 'Sans surcoût, sans abonnement' },
];
---

<section id="cout" class="bg-cream px-6 md:px-10 py-24 md:py-32">
  <div class="max-w-[1200px] mx-auto">

    <FadeInSection client:load>
      <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-ember-deep mb-5">
        <span class="inline-block h-[2px] w-12 bg-ember-deep/70"></span>
        Ce que ça remplace
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,460px)] gap-6 lg:gap-16 items-end">
        <h2 class="text-[40px] md:text-[52px] font-bold leading-[1.06] tracking-[-0.035em] text-ink max-w-[720px] m-0">
          Une formule, au lieu de quatre produits.
        </h2>
        <p class="text-[17px] md:text-lg leading-relaxed text-ink-2 m-0 lg:pb-2">
          Une routine empile un sérum, une crème, un soin ciblé, un écran. Votre formule fait
          le travail des quatre. Comparaison à durée égale : deux à trois mois d'utilisation
          de part et d'autre.
        </p>
      </div>
    </FadeInSection>

    <div class="mt-14 md:mt-16 grid grid-cols-1 lg:grid-cols-2 gap-5 lg:gap-6">

      {/* Colonne gauche : la pile cosmétique */}
      <FadeInSection client:load>
        <div class="h-full rounded-[16px] border border-black/[0.08] bg-base p-7 md:p-8 flex flex-col">
          <div class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-3 mb-7">
            Une routine cosmétique
          </div>

          <div class="flex-1">
            {routine.map((r, i) => (
              <div class={`flex items-baseline justify-between gap-6 py-3.5 ${i < routine.length - 1 ? 'border-b border-black/[0.06]' : ''}`}>
                <span class="text-[15.5px] text-ink-2">{r.label}</span>
                <span class="text-[15.5px] font-medium text-ink-3 tabular-nums">{r.price}</span>
              </div>
            ))}
          </div>

          <div class="mt-7 pt-6 border-t border-black/[0.1]">
            <div class="flex items-baseline justify-between gap-6">
              <span class="text-[15px] text-ink-2">Quatre produits, deux à trois mois</span>
              <span class="text-[34px] font-bold tracking-[-0.03em] text-ink-3 tabular-nums leading-none">160 €</span>
            </div>
            <p class="mt-4 text-[14px] leading-[1.55] text-ink-3 m-0">
              Choisis sans diagnostic, sans personne pour ajuster quand ça ne marche pas.
              Rien n'est remboursé.
            </p>
          </div>
        </div>
      </FadeInSection>

      {/* Colonne droite : Mixt */}
      <FadeInSection client:load delay={0.1}>
        <div class="h-full rounded-[16px] bg-deep text-white p-7 md:p-8 flex flex-col">
          <div class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-white/50 mb-7">
            Avec Mixt
          </div>

          <div class="flex-1">
            {mixt.map((r, i) => (
              <div class={`py-3.5 ${i < mixt.length - 1 ? 'border-b border-white/[0.12]' : ''}`}>
                <div class="flex items-baseline justify-between gap-6">
                  <span class="text-[15.5px] text-white">{r.label}</span>
                  <span class="text-[15.5px] font-semibold text-white tabular-nums shrink-0">{r.price}</span>
                </div>
                <div class="mt-1 text-[13px] text-white/55">{r.note}</div>
              </div>
            ))}
          </div>

          <div class="mt-7 pt-6 border-t border-white/20">
            <div class="flex items-baseline justify-between gap-6">
              <span class="text-[15px] text-white/70">Un tube, deux à trois mois</span>
              <span class="text-[34px] font-bold tracking-[-0.03em] text-white tabular-nums leading-none">30-60 €</span>
            </div>
            <p class="mt-4 text-[14px] leading-[1.55] text-white/70 m-0">
              Une seule formule, prescrite pour votre peau, ajustée au fil du suivi.
              La consultation ne se paie qu'une fois, à l'entrée.
            </p>
          </div>
        </div>
      </FadeInSection>

    </div>

    {/* Objection mutuelle : c'est ici qu'elle se pose, pas ailleurs. */}
    <FadeInSection client:load delay={0.18}>
      <div class="mt-10 rounded-[14px] border border-black/[0.08] bg-base p-6 md:p-7 max-w-[860px]">
        <div class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-ember-deep mb-3">
          Et la mutuelle ?
        </div>
        <p class="m-0 text-[15.5px] leading-[1.6] text-ink-2">
          Une préparation magistrale est un médicament prescrit : la pharmacie vous remet une
          facture, et la plupart des mutuelles en remboursent une partie. Un cosmétique acheté
          en parapharmacie, jamais. C'est toute la différence entre une routine et un traitement.
        </p>
      </div>
    </FadeInSection>

  </div>
</section>
