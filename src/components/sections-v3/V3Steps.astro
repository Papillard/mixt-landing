---
import StickySteps from '../motion/StickySteps.tsx';
import FadeInSection from '../motion/FadeInSection.tsx';

const steps = [
  {
    number: '01',
    title: 'Racontez votre peau',
    desc: "En 5 minutes, l'assistant IA Mixt vous pose les bonnes questions et réunit vos photos. Votre médecin les étudie en amont. Gratuit et sécurisé.",
  },
  {
    number: '02',
    title: 'Consultez votre médecin',
    desc: "Une visio avec un médecin expert de la peau du visage, qui a étudié votre dossier en amont et prépare un plan de traitement adapté, pour une consultation précise.",
  },
  {
    number: '03',
    title: 'Votre traitement personnalisé',
    desc: "Un traitement pensé pour votre peau, pas pour tout le monde : une formule sur mesure préparée par une pharmacie partenaire, sur prescription de votre médecin.",
  },
  {
    number: '04',
    title: 'Suivez votre évolution',
    desc: "L'équipe Mixt et l'assistant IA vous suivent au quotidien : questions pratiques, journal photo, ajustements de routine. Inclus, sans surcoût.",
  },
];

const panels = [
  {
    label: 'Étape 01',
    kind: 'image' as const,
    src: '/images/woman-mirror-melasma.jpg',
    alt: 'Auto-observation de sa peau au miroir',
  },
  {
    label: 'Étape 02',
    kind: 'image' as const,
    src: '/images/step-02-consultation.jpg',
    alt: 'Téléconsultation avec la dermatologue depuis chez soi',
  },
  {
    label: 'Étape 03',
    kind: 'image' as const,
    src: '/images/step-03-lab.jpg',
    alt: 'Formule magistrale préparée en pharmacie partenaire',
    objectPosition: 'center 82%',
  },
  {
    label: 'Étape 04',
    kind: 'chat' as const,
    chat: [
      { from: 'assistant' as const, text: 'Votre consultation est terminée. Votre plan de traitement est prêt.' },
      { from: 'user' as const, text: "J'ai des rougeurs après 3 jours, c'est normal ?" },
      { from: 'assistant' as const, text: 'Oui, très fréquent au début. On garde le rythme. Si ça persiste, je préviens votre médecin.' },
    ],
  },
];
---

<section class="px-6 md:px-10 py-24 md:py-32 bg-base">
  <div class="max-w-[1200px] mx-auto">
    <FadeInSection client:load>
      <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-ember-deep mb-5">
        <span class="inline-block h-px w-10 bg-ember-deep/80"></span>
        Le parcours
      </div>
      <h2 class="text-[40px] md:text-[52px] font-medium leading-[1.06] tracking-[-0.035em] max-w-[720px] mb-5 text-ink">
        Comment <span class="italic-serif">ça marche</span>
      </h2>
      <p class="text-[17px] md:text-lg leading-relaxed text-ink-2 max-w-[640px] mb-14 md:mb-20">
        Quatre étapes pensées pour que la dermatologie travaille vraiment pour vous.
      </p>
    </FadeInSection>

    <StickySteps client:load steps={steps} panels={panels} />

    <FadeInSection client:load>
      <div class="flex justify-center mt-20 md:mt-28">
        <div class="inline-flex flex-col md:flex-row md:flex-wrap items-center md:justify-center gap-2.5 md:gap-[18px] px-5 py-3 md:px-[22px] md:py-[14px] rounded-2xl md:rounded-full border border-ink/[0.12] bg-base/70 backdrop-blur-md text-center md:text-left max-w-[340px] md:max-w-none">
          <span class="inline-flex items-center gap-[7px] font-mono text-[12.5px] tracking-[0.16em] uppercase text-jade-deep font-medium">
            <span class="inline-block w-[6px] h-[6px] rounded-full bg-jade shadow-[0_0_0_3px_rgba(95,191,163,0.18)]"></span>
            HDS · France
          </span>
          <span class="text-[15px] md:text-[16.5px] text-ink font-medium leading-snug">Vos données et vos photos sont sécurisées et soumises au secret médical.</span>
        </div>
      </div>
    </FadeInSection>
  </div>
</section>
