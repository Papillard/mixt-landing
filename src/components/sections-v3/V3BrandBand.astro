---
// Bande texture de marque, slogan blanc posé sur la photo (pas de voile).
interface Props { image: string; slogan: string; position?: string }
const { image, slogan, position = 'center' } = Astro.props;
---

<section class="relative h-[52vw] max-h-[420px] min-h-[240px] overflow-hidden bg-deep">
  <img src={image} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" style={`object-position: ${position};`} />
  <p class="absolute left-6 md:left-10 lg:left-16 bottom-7 md:bottom-12 max-w-[680px] text-balance text-[36px] md:text-[60px] lg:text-[72px] font-bold leading-[1] tracking-[-0.045em] text-white [text-shadow:0_1px_12px_rgba(0,0,0,0.25)]">
    {slogan}
  </p>
</section>
