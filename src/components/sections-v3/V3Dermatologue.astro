---
import FadeInSection from '../motion/FadeInSection.tsx';

// Registre volontairement sobre : pas de titres hospitaliers, pas de superlatif,
// pas de comparaison avec d'autres praticiens (code de déontologie, art. R.4127-19/20).
const facts = [
  {
    label: 'Dermatologue',
    detail: "Inscrite à l'Ordre des médecins, RPPS vérifiable.",
  },
  {
    label: 'Protocoles',
    detail: "Revus à chaque évolution des recommandations françaises.",
  },
  {
    label: 'Dossiers complexes',
    detail: "Relus avec le médecin qui vous suit, quand le cas le demande.",
  },
];
---

{/* Carte aubergine posée dans le fond clair : on garde le contraste qui ancre
    la section sans peindre un écran entier en sombre. */}
<section id="dermatologue" class="bg-base px-6 md:px-10 py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto">
    <div class="rounded-[20px] bg-deep text-white overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] gap-8 lg:gap-14 p-7 md:p-10 lg:p-12 items-center">

        <FadeInSection client:load>
          <figure class="m-0">
            <div class="aspect-[4/5] overflow-hidden rounded-[14px] bg-white/10">
              <img
                src="/images/shoot-dermatologue.webp"
                alt="Dr Bethsabée Levy Garel, dermatologue, fondatrice de Mixt"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-[center_22%]"
              />
            </div>
            <figcaption class="mt-4">
              <div class="text-[17px] font-semibold tracking-[-0.01em]">Dr Bethsabée Levy Garel</div>
              <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-white/50 mt-1.5">
                Dermatologue · Fondatrice de Mixt
              </div>
            </figcaption>
          </figure>
        </FadeInSection>

        <FadeInSection client:load delay={0.12}>
          <div>
            <div class="flex items-center gap-3 font-mono text-[12px] font-semibold uppercase tracking-[0.2em] text-white/50 mb-6">
              <span class="inline-block h-[2px] w-12 bg-white/30"></span>
              Qui écrit votre traitement
            </div>

            <h2 class="text-[32px] md:text-[44px] font-bold leading-[1.08] tracking-[-0.035em] max-w-[640px] mb-7">
              Chaque protocole, écrit et relu par une dermatologue.
            </h2>

            <p class="text-[16.5px] md:text-[17.5px] leading-[1.65] text-white/75 max-w-[600px] m-0">
              C'est Bethsabée qui écrit les protocoles Mixt : quels actifs, quel dosage, pour
              quelle peau. Le médecin que vous consultez les applique, et elle relit avec lui
              chaque dossier qui sort du cadre.
              <span class="text-white"> Si votre peau demande un examen en cabinet, on vous le dit.</span>
            </p>

            <dl class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-x-7 gap-y-6">
              {facts.map((f, i) => (
                <div class={i > 0 ? 'sm:pl-7 sm:border-l sm:border-white/15' : ''}>
                  <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/45 mb-2">{f.label}</dt>
                  <dd class="m-0 text-[13.5px] leading-[1.5] text-white/80">{f.detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        </FadeInSection>

      </div>
    </div>
  </div>
</section>
