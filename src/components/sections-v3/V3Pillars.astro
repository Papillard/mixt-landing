---
import PillarCard from '../motion/PillarCard.tsx';
import FadeInSection from '../motion/FadeInSection.tsx';

const pillars = [
  {
    image: '/images/shoot-persona-acne-pih.webp',
    objectPosition: 'center 20%',
    alt: 'Macro peau',
    title: 'Un plan construit par étapes',
    description: "Votre médecin ne traite pas qu'un symptôme. Il construit un plan progressif : on attaque, on stabilise, puis on entretient les résultats.",
    overlay: {
      kind: 'score' as const,
      label: 'Plan de traitement',
      rows: [
        { label: 'Attaque', value: 'Mois 1-2' },
        { label: 'Stabilisation', value: 'Mois 3-4' },
        { label: 'Entretien', value: 'Mois 5-6' },
      ],
      footer: 'Un plan progressif, construit avec votre médecin dès la consultation.',
    },
  },
  {
    image: '/images/agence-lifestyle-lit.webp',
    objectPosition: 'center 40%',
    alt: 'Patiente lisant un message de suivi depuis son canapé',
    title: 'Un suivi inclus, à vos côtés',
    description: "Après la consultation, l'équipe Mixt reste à vos côtés et l'assistant IA suit votre peau au quotidien : vos questions, votre journal photo, vos doutes. Vous n'êtes jamais seul·e. Inclus, sans surcoût.",
    overlay: {
      kind: 'chat' as const,
      doctor: 'Équipe Mixt',
      status: 'Répond sous 24h',
      message: "Des rougeurs après 3 jours ? Fréquent au début, on garde le rythme.",
      reply: 'Poser une question →',
    },
  },
];
---

<section id="approche" class="px-6 md:px-10 py-24 md:py-32 bg-cream">
  <div class="max-w-[1200px] mx-auto">
    <FadeInSection client:load>
      <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-warm mb-5">
        <span class="inline-block h-px w-10 bg-warm/80"></span>
        Notre approche
      </div>
      <h2 class="text-[40px] md:text-[52px] font-medium leading-[1.06] tracking-[-0.035em] max-w-[760px] mb-5 text-ink">
        On vous accompagne<br class="hidden md:inline" /> <span class="italic-serif whitespace-nowrap">du début à la fin</span>
      </h2>
      <p class="text-[17px] md:text-lg leading-relaxed text-ink-2 max-w-[580px]">
        De votre bilan à un traitement qui fonctionne, puis un accompagnement qui continue. Après la consultation, l'assistant IA et l'équipe Mixt restent à vos côtés, sans jamais vous laisser seul·e.
      </p>
    </FadeInSection>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-7 max-w-[820px] mt-14 md:mt-16">
      {pillars.map((p, i) => (
        <PillarCard
          client:load
          image={p.image}
          alt={p.alt}
          objectPosition={p.objectPosition}
          tag={p.tag}
          title={p.title}
          description={p.description}
          overlay={p.overlay}
          index={i}
        />
      ))}
    </div>
  </div>
</section>
