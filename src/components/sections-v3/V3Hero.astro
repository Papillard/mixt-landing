---
import Button from '../Button.astro';
import FadeInSection from '../motion/FadeInSection.tsx';

const startHref = 'https://app.mixt.care/start';

// Copy du hero isolée ici : en cours de test, à remplacer facilement.
const h1Lead = 'Acné, taches, rougeurs :';
const h1Main = 'un traitement fait pour votre peau, par un médecin';
const subFirst = 'Un médecin vous voit en visio, construit votre plan de traitement et l\'ajuste au fil des semaines.';

// Barre de réassurance sous les CTA : une preuve par colonne, pas de verbatim.
const proof = [
  { top: 'Sous 7 jours', label: 'Consultation en visio' },
  { top: 'Une seule formule', label: 'Au lieu de 4 produits' },
  { top: 'Suivi inclus', label: 'Sans surcoût' },
];

// Mobile : les arguments de vente empilés, un par ligne (USP vitesse, prix, suivi).
const proofMobile = [
  'Un médecin en visio sous 7 jours',
  'Formule en pharmacie, si prescrite',
  'Suivi inclus, sans abonnement',
];
---

<section class="relative px-6 md:px-10 pt-[calc(56px+20px)] lg:pt-[calc(56px+40px)] pb-12 md:pb-24 bg-base">
  <div class="max-w-[1240px] mx-auto grid grid-cols-1 lg:grid-cols-[1.08fr_1fr] gap-5 lg:gap-16 items-center">

    <div>
      <FadeInSection client:load y={10}>
        {/* Preuve sociale en premier : étoiles Trustpilot seules, sans note. */}
        <div class="flex items-center gap-2 mb-4 lg:mb-6">
          <span class="flex items-center gap-[3px]">
            {[0, 1, 2, 3, 4].map(() => (
              <span class="inline-flex h-[16px] w-[16px] items-center justify-center rounded-[2px]" style="background:#00b67a">
                <span class="text-[10px] leading-none text-white">★</span>
              </span>
            ))}
          </span>
          <span class="text-[13px] font-medium text-ink-2">Avis vérifiés Trustpilot</span>
        </div>
      </FadeInSection>

      <FadeInSection client:load delay={0.06} y={14}>
        <h1 class="text-[min(27px,6.9vw)] md:text-[48px] lg:text-[min(48px,3.6vw)] leading-[1.14] tracking-[-0.04em] text-ink m-0">
          <span class="font-semibold">{h1Lead}</span><br />
          <span class="font-semibold">{h1Main}</span>
        </h1>
      </FadeInSection>

      <FadeInSection client:load delay={0.14} y={14}>
        <p class="mt-3 lg:mt-7 text-[15.5px] md:text-[18px] leading-[1.5] lg:leading-[1.6] text-ink-2 max-w-[520px]">
          {subFirst}
        </p>
      </FadeInSection>

      <FadeInSection client:load delay={0.22} y={14} className="hidden lg:block">
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href={startHref} variant="ember-pill">Démarrer ma consultation</Button>
          <Button href={startHref} variant="ghost">Faire mon bilan gratuit</Button>
        </div>
        <p class="mt-4 text-[13.5px] text-ink-3 leading-[1.5]">
          Bilan gratuit et sans engagement. Consultation à 49 €, seulement si vous la réservez.
        </p>
      </FadeInSection>

      <FadeInSection client:load delay={0.3} y={12} className="hidden lg:block">
        <div class="mt-9 pt-7 border-t border-black/[0.09] flex flex-wrap gap-x-9 gap-y-5">
          {proof.map((p) => (
            <div>
              <span class="block h-[18px] text-[14px] font-semibold text-ink leading-[18px]">{p.top}</span>
              <span class="block mt-1.5 text-[13px] text-ink-3">{p.label}</span>
            </div>
          ))}
        </div>
      </FadeInSection>
    </div>

    <FadeInSection client:load delay={0.18} y={24}>
      <div class="relative">
        <div class="relative aspect-[5/4] lg:aspect-auto lg:h-[600px] overflow-hidden rounded-[20px] bg-cream">
          <img
            src="/images/shoot-persona-melasma.webp"
            alt="Portrait de femme, peau avec taches pigmentaires"
            class="absolute inset-0 h-full w-full object-cover object-[center_28%]"
            fetchpriority="high"
          />
        </div>

        {/* Carte flottante haute : le médecin a rendu son plan */}
        <div class="absolute left-3 bottom-3 lg:bottom-auto lg:-left-6 lg:top-10 z-[5] flex items-center gap-3 rounded-[12px] bg-white px-4 py-3 shadow-[0_8px_28px_-10px_rgba(50,25,34,0.28)]">
          <img
            src="/images/shoot-dermatologue-avatar.webp"
            alt=""
            aria-hidden="true"
            width="36"
            height="36"
            class="h-9 w-9 shrink-0 rounded-full object-cover border border-black/[0.06]"
          />
          <span>
            <span class="block text-[13.5px] font-semibold leading-tight text-ink">Plan de traitement prêt</span>
            <span class="block mt-0.5 text-[12px] leading-tight text-ink-3">Validé par votre médecin</span>
          </span>
        </div>

        {/* Carte flottante basse : ce que contient la formule */}
        <div class="hidden lg:block absolute -right-6 bottom-8 z-[5] max-w-[268px] rounded-[12px] bg-white px-4 py-3.5 shadow-[0_8px_28px_-10px_rgba(50,25,34,0.28)]">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">
            Votre formule
          </span>
          <span class="mt-1.5 block text-[15px] font-semibold leading-tight text-ink">Crème sur mesure</span>
          <span class="mt-1.5 block text-[12.5px] leading-[1.45] text-ink-2">
            Actifs et dosages choisis<br />par votre médecin.
          </span>
        </div>
      </div>
    </FadeInSection>

    {/* Mobile : réassurance sous la photo, une ligne par argument */}
    <ul class="lg:hidden list-none m-0 rounded-[14px] bg-white border border-black/[0.06] px-4 py-3.5 flex flex-col gap-2.5">
      {proofMobile.map((t) => (
        <li class="flex items-center gap-2.5 text-[15px] leading-snug text-ink">
          <svg class="h-[18px] w-[18px] shrink-0 text-jade" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 10.5 L8 15 L16.5 5.5" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {t}
        </li>
      ))}
    </ul>

  </div>
</section>
