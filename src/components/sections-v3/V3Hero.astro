---
import Button from '../Button.astro';
import FadeInSection from '../motion/FadeInSection.tsx';

const startHref = 'https://app.mixt.care/start';

// Barre de réassurance sous les CTA : une preuve par colonne, pas de verbatim.
const proof = [
  { top: 'stars' as const, label: 'Avis vérifiés Trustpilot' },
  { top: 'Sur ordonnance', label: 'Préparée en pharmacie' },
  { top: 'Suivi inclus', label: 'Sans surcoût' },
];
---

<section class="relative px-6 md:px-10 pt-[calc(56px+40px)] pb-20 md:pb-24 bg-base">
  <div class="max-w-[1240px] mx-auto grid grid-cols-1 lg:grid-cols-[1.08fr_1fr] gap-12 lg:gap-16 items-center">

    <div>
      <FadeInSection client:load y={10}>
        <div class="inline-flex items-center gap-2.5 rounded-full bg-white border border-black/[0.06] px-4 py-2 shadow-[0_1px_3px_rgba(0,0,0,0.04)] mb-7">
          <span class="h-[7px] w-[7px] rounded-full bg-ember shrink-0"></span>
          <span class="font-mono text-[11px] md:text-[12px] tracking-[0.02em] text-ink-2">
            Médecins formés en dermatologie · Consultation sous 7 jours
          </span>
        </div>
      </FadeInSection>

      <FadeInSection client:load delay={0.06} y={14}>
        <h1 class="text-[42px] md:text-[60px] leading-[1.02] tracking-[-0.04em] text-ink m-0">
          <span class="font-medium">Votre peau mérite</span><br />
          <span class="font-medium">une skincare</span><br />
          <span class="font-bold">qui agit vraiment<span class="text-ember">.</span></span>
        </h1>
      </FadeInSection>

      <FadeInSection client:load delay={0.14} y={14}>
        <p class="mt-7 text-[17px] md:text-[18px] leading-[1.6] text-ink-2 max-w-[520px]">
          Un médecin formé à la dermatologie vous prescrit une formule sur mesure, avec les
          actifs dont votre peau a réellement besoin. Préparée en pharmacie, ajustée dans la durée.
        </p>
      </FadeInSection>

      <FadeInSection client:load delay={0.22} y={14}>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <Button href={startHref} variant="ember-pill">Commencer ma consultation</Button>
          <a
            href="#preparation"
            class="text-[15px] font-medium text-ink underline underline-offset-[5px] decoration-ink/25 hover:decoration-ink transition-colors"
          >
            Voir comment ça marche
          </a>
        </div>
        <p class="mt-4 text-[13.5px] text-ink-3">
          Bilan gratuit · Consultation à 49 €, intégralement reversés au médecin
        </p>
      </FadeInSection>

      <FadeInSection client:load delay={0.3} y={12}>
        <div class="mt-9 pt-7 border-t border-black/[0.09] flex flex-wrap gap-x-12 gap-y-5">
          {proof.map((p) => (
            <div>
              {p.top === 'stars' ? (
                <span class="flex items-center gap-[3px] h-[18px]">
                  {[0, 1, 2, 3, 4].map(() => (
                    <span class="inline-flex h-[15px] w-[15px] items-center justify-center rounded-[2px]" style="background:#00b67a">
                      <span class="text-[9px] leading-none text-white">★</span>
                    </span>
                  ))}
                </span>
              ) : (
                <span class="block h-[18px] text-[14px] font-semibold text-ink leading-[18px]">{p.top}</span>
              )}
              <span class="block mt-1.5 text-[13px] text-ink-3">{p.label}</span>
            </div>
          ))}
        </div>
      </FadeInSection>
    </div>

    <FadeInSection client:load delay={0.18} y={24}>
      <div class="relative">
        <div class="relative aspect-[4/5] lg:aspect-auto lg:h-[600px] overflow-hidden rounded-[20px] bg-cream">
          <img
            src="/images/shoot-persona-rosacee-soin.webp"
            alt="Patiente Mixt suivie pour une rosacée"
            class="absolute inset-0 h-full w-full object-cover object-[center_32%]"
            fetchpriority="high"
          />
        </div>

        {/* Carte flottante haute : le médecin a rendu son plan */}
        <div class="absolute -left-3 top-8 md:-left-6 md:top-10 z-[5] flex items-center gap-3 rounded-[12px] bg-white px-4 py-3 shadow-[0_8px_28px_-10px_rgba(36,26,29,0.28)]">
          <img
            src="/images/shoot-dermatologue-avatar.webp"
            alt=""
            aria-hidden="true"
            width="36"
            height="36"
            class="h-9 w-9 shrink-0 rounded-full object-cover border border-black/[0.06]"
          />
          <span>
            <span class="block text-[13.5px] font-semibold leading-tight text-ink">Plan de traitement prêt</span>
            <span class="block mt-0.5 text-[12px] leading-tight text-ink-3">Validé par votre médecin</span>
          </span>
        </div>

        {/* Carte flottante basse : ce que contient la formule */}
        <div class="absolute -right-2 bottom-6 md:-right-6 md:bottom-8 z-[5] max-w-[268px] rounded-[12px] bg-white px-4 py-3.5 shadow-[0_8px_28px_-10px_rgba(36,26,29,0.28)]">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">
            Votre formule · Semaine 6
          </span>
          <span class="mt-1.5 block text-[15px] font-semibold leading-tight text-ink">Crème sur mesure</span>
          <span class="mt-1.5 block text-[12.5px] leading-[1.45] text-ink-2">
Acide azélaïque, ivermectine.<br />Rougeurs en nette baisse.
          </span>
        </div>
      </div>
    </FadeInSection>

  </div>
</section>
