---
// Équipe médicale : dermatologue en grand, les deux médecins à côté, le pharmacien en ligne dédiée.
// Registre sobre (déontologie R.4127-19/20) : pas de superlatif, pas de comparaison.
import FadeInSection from './motion/FadeInSection.tsx';

interface Props {
  bg?: string;
}
const { bg = 'bg-base' } = Astro.props;
// La dermatologue a sa propre carte marron (V3Dermatologue) juste au-dessus : ici, l'équipe qui vous suit au quotidien.

const doctors = [
  {
    img: '/images/real/medecin-anais-drouet-portrait-01.webp',
    name: 'Dr Anaïs Daoud',
    role: 'Médecin partenaire',
    body: 'Vous reçoit en visio et suit votre traitement.',
  },
  {
    img: '/images/real/medecin-estelle-grimonet-portrait-01.webp',
    name: 'Dr Estelle Grimonet',
    role: 'Médecin partenaire',
    body: 'Vous reçoit en visio et suit votre traitement.',
  },
];
const pharma = {
  img: '/images/real/pharmacien-fabien-bruno-labo-pipette-01.webp',
  name: 'Fabien Bruno',
  role: 'Pharmacien',
  body: "Travaille avec la dermatologue à la conception des formules magistrales : actifs, bases, stabilité.",
};
---

<section id="equipe-medicale" class={`px-6 md:px-10 pt-4 pb-24 md:pt-6 md:pb-32 ${bg}`}>
  <div class="max-w-[1180px] mx-auto">
    <FadeInSection client:load>
      <div class="font-mono text-[11px] md:text-[12px] font-medium uppercase tracking-[0.16em] text-ink mb-5">
        Ils travaillent avec Mixt
      </div>
      <h2 class="text-balance text-[32px] md:text-[46px] font-bold leading-[1.06] tracking-[-0.035em] text-ink max-w-[760px] mb-4">
        Médecins, dermatologues, pharmaciens
      </h2>
      <p class="text-[17px] md:text-[18px] leading-[1.6] text-ink-2 max-w-[620px] mb-12 md:mb-14">
        Quelques visages des professionnels de santé avec qui nous travaillons, de la consultation au suivi.
      </p>
    </FadeInSection>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {[...doctors, pharma].map((d, i) => (
        <FadeInSection client:load delay={0.08 * i}>
          <figure class="m-0">
            <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-cream">
              <img src={d.img} alt={`${d.name}, ${d.role}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-[center_20%]" />
            </div>
            <figcaption class="mt-5">
              <div class="text-[17px] font-semibold tracking-[-0.02em] text-ink">{d.name}</div>
              <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-2 mt-1.5 mb-3">{d.role}</div>
              <p class="text-[14.5px] leading-[1.6] text-ink-2 m-0">{d.body}</p>
            </figcaption>
          </figure>
        </FadeInSection>
      ))}
      <FadeInSection client:load delay={0.24}>
        <div class="aspect-[4/5] rounded-2xl bg-deep text-white p-6 flex flex-col justify-end">
          <div class="text-[22px] md:text-[26px] font-bold leading-[1.1] tracking-[-0.03em] mb-3">Et tout notre réseau</div>
          <p class="text-[14.5px] leading-[1.55] text-white/75 m-0">D'autres médecins partenaires, et l'équipe Mixt qui répond à vos questions pratiques au quotidien.</p>
        </div>
      </FadeInSection>
    </div>

    <p class="mt-6 text-[12.5px] text-ink-3">
      Médecins inscrits à l'Ordre, RPPS vérifiables
    </p>
  </div>
</section>
