---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { siteGraph } from '../data/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  structuredData?: unknown;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://mixt.care/images/og-home.png',
  ogTitle,
  ogDescription,
  structuredData,
  bodyClass = '',
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
// JSON-LD : graphe commun (site, organisation, dermatologue) + nœuds propres à la page,
// dans un seul bloc pour que les références @id se résolvent.
const pageNodes = (() => {
  if (!structuredData) return [];
  const { '@context': _ctx, ...rest } = structuredData as Record<string, unknown>;
  return Array.isArray(rest['@graph']) ? (rest['@graph'] as unknown[]) : [rest];
})();
const jsonLd = { '@context': 'https://schema.org', '@graph': [...siteGraph, ...pageNodes] };
const ogTitleFinal = ogTitle ?? title;
const ogDescFinal = ogDescription ?? description;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="vDeRnnaIbCDZpBcv0n-I1k51JxGtdYrh95chK5fqJ8A" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#191C21" />
  <meta name="author" content="Mixt" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={ogTitleFinal} />
  <meta property="og:description" content={ogDescFinal} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogTitleFinal} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Mixt" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitleFinal} />
  <meta name="twitter:description" content={ogDescFinal} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
  <link rel="manifest" href="/favicons/site.webmanifest" />

  <!-- Le bilan vit sur app.mixt.care : connexion ouverte dès l'arrivée (DNS + TLS),
       le clic sur un CTA ne paie plus ce délai. Pas de prefetch de la page : l'ouvrir
       crée un parcours anonyme côté app et fausserait les arrivées funnel. -->
  <link rel="preconnect" href="https://app.mixt.care" />
  <link rel="dns-prefetch" href="https://app.mixt.care" />

  <!-- Fonts self-hébergées (RGPD : aucune requête vers Google, cf. src/styles/fonts.css) -->
  <link rel="preload" href="/fonts/geist-4.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class={bodyClass}>
  <slot />
  <script defer src="/cookies.js"></script>
  <script defer src="/app-links.js"></script>
  <Analytics />
</body>
</html>
