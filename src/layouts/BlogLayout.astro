---
// Article de blog SEO : hero éditorial centré (kicker, H1, intro, méta, photo 3/2), sommaire
// auto des H2, corps en colonne de lecture ~720px,
// « Quand consulter », FAQ (même rendu que les landings), CTA final, maillage.
// Mode d'emploi : docs/seo/sprints/blog-howto.md
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Accordion from '../components/motion/Accordion.tsx';
import { SITE, ORG_ID, WEBSITE_ID } from '../data/schema';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const d = entry.data;

const CTA_HREF = 'https://app.mixt.care/rdv';
const CTA_NOTE = 'Bilan gratuit et sans engagement. Consultation à 49 €, seulement si vous la réservez.';

// Landings piliers : libellé du lien et mot par défaut du CTA.
const PILLARS: Record<string, { label: string; topic: string }> = {
  rosacee: { label: 'Rosacée et couperose', topic: 'rosacée' },
  taches: { label: 'Masque de grossesse et taches', topic: 'masque de grossesse' },
  acne: { label: 'Acné adulte et acné hormonale', topic: 'acné' },
  hyperpigmentation: { label: 'Taches brunes et hyperpigmentation', topic: 'hyperpigmentation' },
};
// Bandeau de marque au milieu de l'article : texture et slogan de la landing pilier.
const BANDS: Record<string, { image: string; slogan: string; position?: string; dark?: boolean }> = {
  rosacee: { image: '/images/real/texture-rouge-goutte-gel-01.webp', slogan: 'Un diagnostic avant les actifs', position: 'center 50%' },
  taches: { image: '/images/real/texture-ambre-bulles-01.webp', slogan: 'Avant les actifs, comprendre la tache', position: 'center 45%' },
  acne: { image: '/images/real/texture-rouge-creme-nacree-01.webp', slogan: 'Les bons actifs commencent par les bonnes questions', position: 'center 40%' },
  hyperpigmentation: { image: '/images/real/texture-gel-transparent-doigt-01.webp', slogan: 'Chaque tache a sa cause', position: 'center 55%', dark: true },
};
const band = BANDS[d.pillar];
const pillar = PILLARS[d.pillar];
// Cartes « À lire aussi » : landing pilier + articles liés, avec photo et sur-titre.
const PILLAR_IMAGES: Record<string, string> = {
  rosacee: '/images/real/patiente-elise-rosacee-portrait-face-01.webp',
  taches: '/images/real/patiente-leonixia-taches-portrait-main-joue-01.webp',
  acne: '/images/real/patiente-laetitia-acne-portrait-face-01.webp',
  hyperpigmentation: '/images/real/patiente-leonixia-taches-portrait-sourire-01.webp',
};
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedCards = [
  { href: `/${d.pillar}/`, kicker: 'Le guide complet', title: PILLARS[d.pillar].label, image: PILLAR_IMAGES[d.pillar] as string | undefined, placeholder: undefined as string | undefined },
  ...d.related.map((r) => {
    const slug = r.href.replace(/^\/blog\//, '').replace(/\/$/, '');
    const post = allPosts.find((p) => p.id === slug);
    return {
      href: r.href,
      kicker: post?.data.kicker ?? 'Article',
      title: post?.data.h1 ?? r.label,
      image: post?.data.heroImage,
      placeholder: post && !post.data.heroImage ? (post.data.heroPlaceholder ?? `PH-${post.id}-hero`) : undefined,
    };
  }),
].slice(0, 3);
const pillarHref = `/${d.pillar}/`;
const topic = d.ctaTopic ?? pillar.topic;
const ctaLabel = `Parler de votre ${topic} à un médecin`;

// Typo française : espace insécable avant « : ? ! » pour éviter un signe seul en début de ligne.
const nbsp = (t: string) => t.replace(/ ([:?!;])/g, '\u00a0$1');
const toc = headings.filter((h) => h.depth === 2);
// Temps de lecture : ~220 mots/minute sur le Markdown brut.
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 220));

const fmt = (date: Date) =>
  date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (date: Date) => date.toISOString().slice(0, 10);

const pageUrl = `${SITE}/blog/${entry.id}/`;
const heroImageUrl = d.heroImage ? `${SITE}${d.heroImage}` : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: d.h1,
      description: d.description,
      inLanguage: 'fr-FR',
      datePublished: iso(d.datePublished),
      dateModified: iso(d.dateModified),
      mainEntityOfPage: pageUrl,
      isPartOf: { '@id': WEBSITE_ID },
      author: { '@id': ORG_ID },
      publisher: { '@id': ORG_ID },
      ...(heroImageUrl && { image: heroImageUrl }),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Dossiers peau', item: `${SITE}/blog/` },
        { '@type': 'ListItem', position: 3, name: d.h1, item: pageUrl },
      ],
    },
    ...(d.faq.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${pageUrl}#faq`,
            mainEntity: d.faq.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout title={d.title} description={d.description} structuredData={structuredData} ogImage={heroImageUrl}>
  <Nav ctaLabel="Démarrer ma consultation" ctaHref={CTA_HREF} stickyCtaMobile />

  {/* ── HERO éditorial centré (à la Medium) : pas de bouton, pas de split photo ── */}
  <header class="bg-white px-6 md:px-10 pt-[calc(56px+40px)] lg:pt-[calc(56px+80px)] pb-10 md:pb-14">
    <div class="max-w-[780px] mx-auto text-center">
      <nav aria-label="Fil d'Ariane" class="mb-8 text-[13px] text-ink-3">
        <a href="/blog/" class="text-ink-3 no-underline hover:text-ink">Dossiers peau</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <a href={pillarHref} class="text-ink-3 no-underline hover:text-ink">{pillar.label}</a>
      </nav>
      <p class="font-mono text-[12px] uppercase tracking-[0.16em] text-ember-deep mb-5">{d.kicker}</p>
      <h1 class="text-balance text-[34px] md:text-[48px] lg:text-[54px] font-bold leading-[1.06] tracking-[-0.035em] text-ink mb-6">
        {nbsp(d.h1)}
      </h1>
      <p class="text-pretty text-[18px] md:text-[20px] leading-[1.6] text-ink-2 max-w-[640px] mx-auto">{nbsp(d.intro)}</p>
      <p class="mt-7 text-[13px] text-ink-3">
        Mis à jour le <time datetime={iso(d.dateModified)}>{fmt(d.dateModified)}</time>
        <span class="mx-1.5" aria-hidden="true">·</span>{readingTime} min de lecture
        <span class="mx-1.5" aria-hidden="true">·</span>{d.reviewedBy}
      </p>
    </div>
    <div class="max-w-[1000px] mx-auto mt-10 md:mt-14">
      {d.heroImage ? (
        <img
          src={d.heroImage}
          alt={d.heroImageAlt ?? ''}
          class="w-full aspect-[3/2] object-cover rounded-[20px]"
          fetchpriority="high"
        />
      ) : (
        <PhotoPlaceholder name={d.heroPlaceholder ?? `PH-${entry.id}-hero`} ratio="3/2" />
      )}
    </div>
  </header>

  {/* ── CORPS : même colonne étroite, sommaire sobre en tête ── */}
  <section class="bg-white px-6 md:px-10 pb-16 md:pb-24 overflow-x-clip">
    <div class="max-w-[780px] mx-auto">
      {toc.length > 0 && (
        <nav aria-label="Sommaire" class="mb-12 border-y border-black/[0.08] py-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-3 mb-4">Sommaire</p>
          <ol class="list-none m-0 p-0 flex flex-col gap-2.5">
            {toc.map((h, i) => (
              <li class="flex gap-3 text-[15.5px] leading-snug">
                <span class="font-mono text-[12px] text-ink-3 pt-[3px] w-5 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <a href={`#${h.slug}`} class="text-ink-2 no-underline hover:text-ink">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <article class="blog-prose" id="article-body">
        <slot />
      </article>

      {/* Bandeau de marque pleine largeur : placé après le 2e chapitre (script), sinon en fin d'article */}
      <aside id="blog-band" class={`blog-band ${band.dark ? 'is-dark' : ''} relative my-16 md:my-20 h-[440px] md:h-[480px] overflow-hidden bg-deep`} aria-label="Parler à un médecin">
        <img src={band.image} alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover" style={`object-position: ${band.position ?? 'center'};`} />
        <div class="absolute inset-x-0 bottom-0 px-6 md:px-10 lg:px-16 pb-9 md:pb-12 max-w-[1280px] mx-auto">
          <p class={`max-w-[680px] text-balance text-[36px] md:text-[56px] lg:text-[64px] font-bold leading-[1.02] tracking-[-0.045em] mb-7 ${band.dark ? 'text-ink' : 'text-white [text-shadow:0_1px_12px_rgba(0,0,0,0.25)]'}`}>{band.slogan}</p>
          <Button href={CTA_HREF} variant={band.dark ? 'ember-pill' : 'white'} size="md">{ctaLabel} →</Button>
        </div>
      </aside>
      <script is:inline>
        (function () {
          var band = document.getElementById('blog-band');
          var h2s = document.querySelectorAll('#article-body > h2');
          if (band && h2s.length >= 4) h2s[2].parentNode.insertBefore(band, h2s[2]);
        })();
      </script>

      {d.whenToConsult.length > 0 && (
        <aside class="mt-14 rounded-[20px] bg-deep text-white px-7 py-8 md:px-10 md:py-10" id="quand-consulter">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-white/60 mb-3">Quand consulter</p>
          <h2 class="text-[24px] md:text-[28px] font-bold leading-[1.15] tracking-[-0.03em] mb-6">Les signes qui justifient un avis médical</h2>
          <ul class="list-none m-0 p-0 flex flex-col gap-3.5">
            {d.whenToConsult.map((t) => (
              <li class="flex gap-3 text-[16px] leading-[1.55] text-white/85">
                <span class="mt-[9px] h-[7px] w-[7px] shrink-0 rounded-full bg-ember" aria-hidden="true"></span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <Button href={CTA_HREF} variant="white" size="md">{ctaLabel} →</Button>
          </div>
          <p class="mt-3 text-[13px] text-white/55">{CTA_NOTE}</p>
        </aside>
      )}
    </div>
  </section>

  {/* ── FAQ : même rendu que les landings ── */}
  {d.faq.length > 0 && (
    <section class="px-6 md:px-10 pt-20 md:pt-28 pb-16 md:pb-24 bg-cream" id="faq">
      <div class="max-w-[1200px] mx-auto">
        <h2 class="text-balance text-[32px] md:text-[44px] font-medium leading-[1.08] tracking-[-0.035em] text-center mb-12 md:mb-16 text-ink">
          Vos questions
        </h2>
        <div class="max-w-[760px] mx-auto">
          <Accordion client:load items={d.faq} />
        </div>
      </div>
    </section>
  )}

  {/* ── MAILLAGE : landing pilier + articles liés, cartes photo ── */}
  <section class="px-6 md:px-10 pb-24 md:pb-28 pt-6 bg-cream">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="text-balance text-[28px] md:text-[36px] font-bold leading-[1.1] tracking-[-0.035em] text-ink mb-8 md:mb-10">À lire aussi</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {relatedCards.map((c) => (
          <a href={c.href} class="group block no-underline">
            <div class="overflow-hidden rounded-[20px] bg-blush/30">
              {c.image ? (
                <img src={c.image} alt="" loading="lazy" class="w-full aspect-[3/2] object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              ) : (
                <PhotoPlaceholder name={c.placeholder ?? 'PH-photo'} ratio="3/2" />
              )}
            </div>
            <p class="mt-5 mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-ember-deep">{c.kicker}</p>
            <h3 class="text-[20px] md:text-[22px] font-bold leading-[1.2] tracking-[-0.025em] text-ink">{nbsp(c.title)}</h3>
            <span class="mt-3 inline-flex items-center gap-1.5 text-[15px] font-medium text-ink-2 group-hover:text-ink">Lire <span class="text-ember transition-transform group-hover:translate-x-[3px]" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── CTA FINAL ── */}
  <section class="px-6 md:px-10 py-24 md:py-32 bg-deep text-white text-center">
    <div class="max-w-[780px] mx-auto">
      <h2 class="text-balance text-[34px] md:text-[46px] font-medium leading-[1.12] tracking-[-0.035em] text-white mb-6 max-w-[680px] mx-auto">
        {ctaLabel}
      </h2>
      <p class="text-[16px] md:text-[18px] leading-[1.65] text-white/60 max-w-[540px] mx-auto mb-9">
        Répondez à quelques questions et ajoutez vos photos, c'est gratuit. Si vous réservez, un médecin partenaire vous reçoit en visio sous 7 jours, avec des protocoles conçus avec une dermatologue.
      </p>
      <Button href={CTA_HREF} variant="white">Faire mon bilan gratuit →</Button>
      <div class="mt-5 text-[13px] text-white/60">{CTA_NOTE}</div>
    </div>
  </section>

  <Footer />
  <MobileStickyCta />
</BaseLayout>

<style is:global>
  .blog-prose { color: var(--color-ink); font-size: 19px; line-height: 1.75; }
  .blog-prose > :first-child { margin-top: 0; }
  .blog-prose h2 {
    font-size: 30px; line-height: 1.15; font-weight: 700; letter-spacing: -0.03em;
    margin: 56px 0 18px; scroll-margin-top: 88px; text-wrap: balance;
  }
  .blog-prose h3 { font-size: 21px; line-height: 1.3; font-weight: 700; letter-spacing: -0.02em; margin: 34px 0 10px; scroll-margin-top: 88px; }
  .blog-prose p { margin: 0 0 20px; color: #2B3036; }
  .blog-prose ul, .blog-prose ol { margin: 0 0 22px; padding-left: 22px; color: #2B3036; }
  .blog-prose ul { list-style: disc; }
  .blog-prose ol { list-style: decimal; }
  .blog-prose li { margin: 0 0 8px; padding-left: 4px; }
  .blog-prose li::marker { color: var(--color-ember); }
  .blog-prose strong { font-weight: 650; color: var(--color-ink); }
  .blog-prose a { color: var(--color-ember-deep); text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose a:hover { color: var(--color-ink); }
  .blog-prose blockquote {
    margin: 28px 0; padding: 20px 24px; border-radius: 14px; background: var(--color-cream);
    font-size: 17px; color: var(--color-ink);
  }
  .blog-prose blockquote p:last-child { margin-bottom: 0; }
  .blog-prose table { width: 100%; border-collapse: collapse; margin: 8px 0 28px; font-size: 16px; }
  .blog-prose th, .blog-prose td { text-align: left; padding: 12px 14px; border-bottom: 1px solid rgba(0,0,0,0.1); vertical-align: top; }
  .blog-prose th { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ink-2); font-weight: 500; }
  .blog-prose img { border-radius: 20px; margin: 32px 0; width: 100%; }
  /* Placeholder photo dans le corps Markdown : <div class="ph">PH-slug-usage</div> */
  .blog-prose .ph {
    margin: 32px 0; aspect-ratio: 3/2; border-radius: 20px; background: var(--color-blush);
    display: flex; align-items: center; justify-content: center; padding: 16px; text-align: center;
    font-family: var(--font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-ink-2);
  }
  .blog-prose small { display: block; margin-top: 40px; font-size: 14px; line-height: 1.6; color: var(--color-ink-3); }
  .blog-band { width: 100vw; margin-left: calc(50% - 50vw); }
  .blog-prose .blog-band img { margin: 0; border-radius: 0; width: 100%; height: 100%; }
  .blog-prose .blog-band p { margin: 0 0 28px; color: #fff; }
  .blog-prose .blog-band.is-dark p { color: var(--color-ink); }
  .blog-prose .blog-band a { text-decoration: none; color: var(--color-ink); }
  .blog-prose .blog-band.is-dark a { color: #fff; }
  @media (max-width: 767px) {
    .blog-prose { font-size: 17.5px; }
    .blog-prose h2 { font-size: 25px; margin-top: 44px; }
    .blog-prose table { display: block; overflow-x: auto; }
  }
</style>
