<script>
  // Révèle chaque bloc [data-rv] à l'entrée dans l'écran et fait monter les compteurs [data-count].
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number, space: boolean) => (space ? Math.round(n).toLocaleString('fr-FR') : String(Math.round(n)));

  const runCounters = (root: Element) => {
    if (reduce) return;
    root.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      if (el.dataset.done) return;
      el.dataset.done = '1';
      const target = Number(el.dataset.count);
      const space = el.dataset.format === 'space';
      const t0 = performance.now();
      const dur = 1300;
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * e, space);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmt(target, space);
      };
      requestAnimationFrame(tick);
    });
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        runCounters(e.target);
        io.unobserve(e.target);
      });
    },
    { threshold: 0.2, rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-rv]').forEach((el) => io.observe(el));
  // Compteurs hors blocs révélés (hero)
  document.querySelectorAll('main > section:first-child').forEach((s) => runCounters(s));
</script>
