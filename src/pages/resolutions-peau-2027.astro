---
// Campagne presse fin d'année : « Résolutions peau 2027 ».
// Source unique des chiffres : dossier « Mixt, résolutions peau 2027 » (note pour la communication, 8 pages).
// Conformité : aucun nom de médicament ni de marque, palmarès par catégories, aucun résultat de traitement.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import FadeInSection from '../components/motion/FadeInSection.tsx';
import MobileStickyCta from '../components/MobileStickyCta.astro';
import { ORG_ID, DERMATO_ID, dermatologist, breadcrumb, SITE } from '../data/schema';

const CTA_HREF = 'https://app.mixt.care/rdv';
const CTA_LABEL = 'Faire mon bilan gratuit';
const CTA_NOTE = 'Bilan gratuit et sans engagement. Consultation à 49 €, seulement si vous la réservez.';

// Dossier presse téléchargeable : le PDF source nomme des médicaments, il ne part pas en ligne tel quel.
// Passer à true une fois public/presse/mixt-resolutions-peau-2027.pdf relu et déposé.
const PRESS_PDF_READY = false;
const PRESS_PDF_HREF = '/presse/mixt-resolutions-peau-2027.pdf';
const PRESS_EMAIL = 'presse@mixt.care'; // à confirmer

const PAGE_URL = `${SITE}/resolutions-peau-2027/`;
const IMG = '/images/real/';

// ── Données (dossier, pages 1 à 8) ──────────────────────────────

const mosaic = [
  'gros-plan-serie-melasma-01',
  'gros-plan-serie-marques-acne-01',
  'gros-plan-serie-taches-solaires-01',
  'gros-plan-serie-comedons-fermes-01',
  'gros-plan-serie-pores-dilates-01',
  'gros-plan-serie-hyperpigmentation-post-inflammatoire-01',
  'gros-plan-serie-cicatrices-acne-01',
  'gros-plan-serie-taches-de-rousseur-01',
];

const resolutions = [
  {
    n: '1', id: 'diagnostic', title: 'Un vrai diagnostic',
    text: "Savoir ce qu'on a avant de choisir quoi mettre. Une acné peut être une rosacée, une tache « de grossesse » peut venir du soleil.",
  },
  {
    n: '2', id: 'traitement', title: 'Le bon traitement',
    text: 'Deux produits bien choisis plutôt que huit qui se contredisent. Une préparation faite pour sa peau, quand le médecin la juge indiquée.',
  },
  {
    n: '3', id: 'suivi', title: 'Un suivi',
    text: 'Introduire les actifs pas à pas, tenir trois mois, ajuster avec un médecin au lieu de changer de crème tous les quinze jours.',
  },
];

// Cinq chiffres : on dessine la fraction annoncée (7 sur 10 = 10 points dont 7 allumés).
const five = [
  { big: '7 sur 10', on: 7, of: 10, text: "vivent avec leur problème de peau depuis plus de deux ans. Pour l'acné, plus d'une sur trois répond « depuis toujours ».", n: '68,7 % · N = 2 113 bilans', tone: 'light' },
  { big: '8 sur 10', on: 8, of: 10, text: "n'ont trouvé aucun traitement efficace parmi tous ceux qu'elles ont essayés.", n: '79,9 % · N = 881 personnes, 2 010 traitements notés', tone: 'deep' },
  { big: '2 sur 3', on: 2, of: 3, text: 'ont déjà réagi à un soin ou à du maquillage : rougeurs, boutons, démangeaisons.', n: '65,4 % · N = 2 539 bilans', tone: 'cream' },
  { big: '1 sur 3', on: 1, of: 3, text: "repart de la consultation avec un traitement pour un autre problème que celui qu'elle pensait avoir.", n: '30,2 % · N = 159 patientes avec préparation magistrale', tone: 'ember' },
  { big: '1 sur 2', on: 1, of: 2, text: 'dit que sa peau pèse sur son quotidien ou qu\'elle est « vraiment difficile à vivre ».', n: '49,9 % · N = 1 944 bilans', tone: 'light' },
];

const reactions = [
  { label: 'Au moins une réaction', v: 65, strong: true },
  { label: 'Rougeurs, sensation de chaleur', v: 40 },
  { label: 'Boutons', v: 32 },
  { label: 'Tiraillements, démangeaisons', v: 28 },
];

const doctorsNotes = [
  { t: 'Des routines qui s\'allongent', d: 'Double nettoyage, lotion, deux ou trois sérums, exfoliant plusieurs soirs par semaine : certains comptes rendus listent sept ou huit produits par jour, achetés au fil des tendances (marques virales, K-beauty, conseils vus sur TikTok).' },
  { t: 'Des actifs qui se doublent sans qu\'on le sache', d: "Un sérum au rétinol par-dessus une crème rétinoïde sur ordonnance, de l'acide salicylique dans trois produits à la fois. Avant d'ajouter quoi que ce soit, les médecins demandent souvent d'enlever." },
  { t: 'Une irritation prise pour la maladie', d: "Dans plusieurs dossiers, la peau qui pèle, chauffe ou rougit réagit aux produits eux-mêmes : la barrière cutanée est abîmée, l'acné ou la rosacée n'y sont pour rien." },
];

// Palmarès « pas efficace » regroupé par catégories (aucun nom de médicament).
// Traitements locaux sur ordonnance : moyenne pondérée par N des 5 lignes du dossier
// (96 × 54 + 92 × 145 + 90 × 104 + 84 × 79 + 79 × 83) / 465 = 88,3 %.
const categories = [
  { label: 'Crèmes et sérums sans ordonnance', v: 98, n: 'N = 600' },
  { label: 'Compléments (zinc)', v: 94, n: 'N = 65' },
  { label: 'Traitements locaux sur ordonnance', v: 88, n: 'moyenne pondérée · N = 465' },
  { label: 'Pilule prescrite pour la peau', v: 83, n: 'N = 88' },
  { label: 'Peelings', v: 83, n: 'N = 54' },
  { label: 'Antibiotiques oraux', v: 78, n: 'N = 149' },
  { label: "Traitement oral de l'acné sévère", v: 47, n: 'N = 65', standout: true },
];

const confusions = [
  { img: 'gros-plan-rosacee-joue-01', alt: 'Rougeurs et petits boutons sur une joue', t: "L'acné qui est une rosacée", d: 'Des boutons sur fond de rougeurs, sans points noirs, qui chauffent. C\'est la confusion la plus courante, et les soins anti-acné classiques agressent alors une peau qui avait besoin d\'être apaisée.' },
  { img: 'gros-plan-serie-taches-solaires-01', alt: 'Taches brunes sur une pommette', t: 'Le « masque de grossesse » qui est un lentigo solaire', d: 'Des taches attribuées aux hormones viennent en fait du soleil et se traitent autrement, souvent au cabinet (laser, froid).' },
  { img: 'gros-plan-eczema-plaque-01', alt: 'Plaque rouge et irritée sur la peau', t: 'La rosacée qui est un eczéma de contact', d: 'Des rougeurs autour des yeux ou de la bouche causées par un produit : il suffit parfois de l\'arrêter.' },
  { img: 'gros-plan-acne-inflammatoire-01', alt: 'Boutons rouges inflammatoires en gros plan', t: "L'acné du dos qui est une folliculite", d: 'Le même aspect, une autre prise en charge (hygiène, textiles, savon antiseptique).' },
  { img: 'gros-plan-melasma-joue-01', alt: 'Taches brunes irrégulières sur une joue', t: "La tache qu'il faut montrer en cabinet", d: 'Sur certaines photos, la dermatologue demande un examen en présentiel pour une lésion liée au soleil. Un bon diagnostic sait aussi orienter.' },
];

// Grille des déclencheurs. null = question non posée pour cette préoccupation.
const triggerCols = ['Cycle, grossesse, hormones', 'Stress', 'Chaleur', 'Soleil', 'Froid, vent', 'Alcool', 'Épices', 'Tabac'];
const triggerRows = [
  { label: 'Acné', n: 'N = 927', v: [69, null, null, null, null, null, null, null] },
  { label: 'Rougeurs', n: 'N = 480', v: [null, 63, 63, null, 54, 38, 22, null] },
  { label: 'Taches', n: 'N = 432', v: [33, null, null, 33, null, null, null, null] },
  { label: 'Rides', n: 'N = 335', v: [null, 63, null, 23, null, null, null, 24] },
];

const hormonal = [
  { t: "L'acné qui arrive à l'âge adulte", d: 'Plusieurs comptes rendus notent « pas d\'acné à l\'adolescence » : les premiers boutons sont venus après 25 ans, après un accouchement ou à l\'arrêt de la pilule.' },
  { t: 'La pilule, avant et après', d: 'Prise pendant des années en partie pour la peau, puis arrêtée : la peau rechute. 83 % de celles qui l\'ont essayée pour leur peau ne la jugent pas efficace (N = 88).' },
  { t: 'Les bonnes questions', d: 'Règles irrégulières, chute de cheveux, poils au menton : les médecins cherchent souvent un syndrome des ovaires polykystiques (SOPK) ou une endométriose et orientent vers un bilan.' },
  { t: 'Le stress', d: 'Près de 2 femmes sur 3 avec des rougeurs le citent. Il apparaît aussi dans les dossiers en toile de fond : séparation, épuisement, période difficile.' },
];

const timeline = [
  { when: 'Semaine 1', t: 'Un actif à la fois', d: 'Deux ou trois soirs par semaine au début. Dans plusieurs dossiers, un traitement a été abandonné après un démarrage trop rapide.' },
  { when: 'Les semaines suivantes', t: 'Progressivement', d: 'Plus souvent, si la peau le supporte.' },
  { when: 'Mois 3', t: 'Juger, puis ajuster', d: 'Les médecins réévaluent à trois mois et ajustent : on ajoute, on espace, on remplace.' },
  { when: 'Entretien', t: "Prévoir l'après", d: "Antibiotiques, pilule, traitement oral de l'acné : plusieurs rechutes décrites surviennent à l'arrêt. Le suivi sert à préparer un traitement d'entretien." },
];
const everyday = [
  { t: 'La protection solaire, tous les matins, toute l\'année', d: 'La consigne la plus répétée, surtout pour les taches : le mélasma signale une peau sensible au soleil pour la vie.' },
  { t: 'Ne pas toucher ses boutons', d: 'Plusieurs dossiers décrivent des boutons percés ou grattés qui laissent des marques. Les médecins proposent parfois un accompagnement pour en sortir.' },
];

const weightLegend = ['Ça va, je gère', 'Gênant par moments', "J'y pense souvent", 'Affecte mon quotidien', 'Vraiment difficile'];
const weightRows = [
  { label: 'Ensemble', n: 'N = 1 944', v: [6, 22, 22, 32, 18] },
  // Le dossier n'affiche pas la première part pour l'acné (trop petite) : segment laissé sans étiquette.
  { label: 'Acné', n: 'N = 957', v: [4, 17, 22, 37, 20], hideFirst: true },
  { label: 'Rougeurs', n: 'N = 528', v: [6, 29, 17, 32, 16] },
  { label: 'Taches', n: 'N = 432', v: [10, 24, 29, 22, 15] },
];

const pressFigures = [
  { big: '7 sur 10', t: 'vivent avec leur problème de peau depuis plus de deux ans.', n: '68,7 % · N = 2 113 bilans' },
  { big: '8 sur 10', t: "n'ont trouvé efficace aucun des traitements qu'elles ont essayés.", n: '79,9 % · N = 881' },
  { big: '98 %', t: 'de celles qui ont essayé des crèmes et sérums sans ordonnance ne les jugent pas efficaces.', n: 'N = 600' },
  { big: '2 sur 3', t: 'ont déjà réagi à un soin ou à du maquillage.', n: '65,4 % · N = 2 539' },
  { big: '1 sur 3', t: "des personnes venues pour de l'acné repartent avec un traitement pour autre chose (rosacée, marques, taches).", n: '37 % · N = 92 patientes' },
  { big: 'Près de la moitié', t: 'des femmes préoccupées par leurs rides ont déjà testé au moins cinq actifs.', n: '47,5 % · N = 80' },
  { big: '7 sur 10', t: 'femmes avec une acné font le lien avec leur cycle.', n: '69,4 % · N = 927' },
  { big: '1 sur 3', t: 'des personnes qui ont des taches les voient apparaître après une grossesse ou un changement hormonal.', n: '33,3 % · N = 432' },
  { big: '1 sur 2', t: 'dit que sa peau affecte son quotidien.', n: '49,9 % · N = 1 944' },
  { big: '2 produits', t: "sur l'ordonnance, en médiane, après le diagnostic.", n: 'N = 181 ordonnances' },
];

// Donut 69 / 17 / 14 (circonférence normalisée à 100 via pathLength).
const donut = [
  { label: '« Pas assez efficace »', v: 69, cls: "stroke-ember", dot: "bg-ember" },
  { label: '« Mal toléré »', v: 17, cls: "stroke-white", dot: "bg-white" },
  { label: '« Efficace »', v: 14, cls: "stroke-ink-3", dot: "bg-ink-3" },
];
let acc = 0;
const donutSegs = donut.map((s) => { const seg = { ...s, offset: -acc }; acc += s.v; return seg; });

// ── SEO ─────────────────────────────────────────────────────────
const title = 'Résolutions peau 2027 : ce que disent 2 545 bilans | Mixt';
const description =
  "2 545 bilans de peau et 236 patientes suivies : 8 sur 10 n'ont trouvé aucun traitement efficace, 2 sur 3 ont déjà réagi à un soin. Trois résolutions pour 2027 : un diagnostic, le bon traitement, un suivi.";

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${PAGE_URL}#article`,
      headline: '2027 : moins de produits, plus de diagnostic',
      description,
      url: PAGE_URL,
      image: `${SITE}/images/og-resolutions-peau-2027.jpg`,
      datePublished: '2026-11-24',
      inLanguage: 'fr-FR',
      author: { '@id': ORG_ID },
      publisher: { '@id': ORG_ID },
      about: ['Acné', 'Rosacée', 'Taches brunes', 'Mélasma'],
    },
    {
      '@type': 'Dataset',
      '@id': `${PAGE_URL}#dataset`,
      name: 'Résolutions peau 2027 : bilans de peau et téléconsultations Mixt',
      description:
        '2 545 bilans de peau remplis en ligne (16/07 au 23/11/2026) et dossiers de 236 patientes vues en téléconsultation (04/05 au 20/11/2026). Données agrégées et anonymes, aucun groupe de moins de 20 personnes publié. Échantillon non représentatif, réponses déclaratives.',
      url: PAGE_URL,
      creator: { '@id': ORG_ID },
      temporalCoverage: '2026-05-04/2026-11-23',
      spatialCoverage: 'France',
      isAccessibleForFree: true,
    },
    dermatologist,
    breadcrumb(PAGE_URL, 'Résolutions peau 2027'),
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={`${SITE}/images/og-resolutions-peau-2027.jpg`}
  ogTitle="2027 : moins de produits, plus de diagnostic"
  structuredData={structuredData}
>
  <script is:inline>document.documentElement.classList.add('rv-js');</script>
  <Nav ctaLabel="Faire mon bilan" ctaHref={CTA_HREF} stickyCtaMobile />

  <main class="pt-14 text-ink">

    <!-- ═══ HERO ═══ -->
    <section class="bg-deep text-white">
      <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:min-h-[calc(100vh-56px)]">
        <div class="order-2 lg:order-1 flex flex-col justify-center px-6 py-14 md:px-14 lg:px-16 lg:py-20">
          <p class="font-mono text-eyebrow uppercase text-white/60">Étude Mixt · Résolutions peau 2027</p>
          <h1 class="mt-6 text-[44px] leading-[0.98] tracking-[-0.045em] md:text-[72px] lg:text-[84px]">
            <span class="block">2027 : moins de produits,</span>
            <span class="block text-ember">plus de diagnostic</span>
          </h1>
          <p class="mt-8 text-[20px] font-semibold leading-snug md:text-[24px]">
            <span data-count="2545" data-format="space">2 545</span> bilans, <span data-count="236">236</span> patientes, ce qu'ils racontent
          </p>
          <p class="mt-5 max-w-[520px] text-body-lg text-white/75">
            En janvier, beaucoup de femmes se promettent de « prendre soin de leur peau » et commencent par acheter un sérum de plus. Les bilans remplis sur Mixt racontent la suite : des étagères pleines, une peau qui réagit, et le sentiment de tourner en rond sans que personne ne regarde vraiment le problème.
          </p>
          <nav class="mt-10 flex flex-wrap gap-2" aria-label="Les trois résolutions">
            {resolutions.map((r) => (
              <a href={`#${r.id}`} class="group inline-flex items-center gap-3 rounded-full border border-white/20 py-2 pl-2 pr-4 text-[14px] font-semibold text-white no-underline transition-colors hover:border-ember hover:bg-ember">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-white font-mono text-[13px] text-deep">{r.n}</span>
                {r.title}
              </a>
            ))}
          </nav>
        </div>
        <div class="order-1 lg:order-2 grid grid-cols-4 grid-rows-2 gap-[3px] bg-deep lg:min-h-[640px]" aria-hidden="true">
          {mosaic.map((m, i) => (
            <div class="mosaic-tile relative overflow-hidden" style={`--i:${i}`}>
              <img src={`${IMG}${m}.webp`} alt="" class="aspect-[4/5] w-full object-cover lg:absolute lg:inset-0 lg:h-full lg:aspect-auto" loading={i < 4 ? 'eager' : 'lazy'} width="1122" height="1402" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ LES 3 RÉSOLUTIONS ═══ -->
    <section class="bg-base px-6 py-16 md:px-14 md:py-24">
      <div class="mx-auto max-w-[1240px]">
        <p class="font-mono text-eyebrow uppercase text-ember-deep">Notre proposition pour 2027</p>
        <h2 class="mt-4 max-w-[760px] text-h2">Trois résolutions, dans cet ordre</h2>
        <ol class="mt-12 grid gap-px overflow-hidden rounded-[6px] bg-ink/10 md:grid-cols-3">
          {resolutions.map((r) => (
            <li class="bg-base p-8 md:p-10" data-rv>
              <a href={`#${r.id}`} class="block no-underline text-ink">
                <span class="block font-mono text-[120px] leading-[0.8] tracking-[-0.06em] text-ember md:text-[160px]">{r.n}</span>
                <span class="mt-8 block text-h3">{r.title}</span>
                <span class="mt-3 block text-body text-ink-2">{r.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══ CINQ CHIFFRES ═══ -->
    <section aria-labelledby="cinq-chiffres">
      <div class="bg-ink px-6 py-6 md:px-14">
        <h2 id="cinq-chiffres" class="mx-auto max-w-[1240px] font-mono text-eyebrow uppercase text-white/70">Cinq chiffres pour résumer</h2>
      </div>
      {five.map((f, i) => {
        const bg = { light: 'bg-base text-ink', deep: 'bg-deep text-white', cream: 'bg-cream text-ink', ember: 'bg-ember text-white' }[f.tone];
        const dotOn = f.tone === 'ember' ? 'bg-white' : 'bg-ember';
        const dotOff = f.tone === 'deep' || f.tone === 'ember' ? 'bg-white/20' : 'bg-ink/10';
        const sub = f.tone === 'deep' || f.tone === 'ember' ? 'text-white/70' : 'text-ink-3';
        return (
          <div class={`${bg} px-6 py-14 md:px-14 md:py-20`}>
            <div class="viz mx-auto grid max-w-[1240px] items-center gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,4fr)] lg:gap-14" data-rv>
              <p class="whitespace-nowrap text-[88px] font-bold leading-[0.85] tracking-[-0.055em] md:text-[128px] xl:text-[150px]">{f.big}</p>
              <div class="flex flex-wrap gap-2 md:gap-3" role="img" aria-label={f.big}>
                {Array.from({ length: f.of }).map((_, d) => (
                  <span class={`dot h-6 w-6 rounded-full md:h-9 md:w-9 ${dotOff}`} style={`--d:${d}`}>
                    {d < f.on && <span class={`dot-on block h-full w-full rounded-full ${dotOn}`} />}
                  </span>
                ))}
              </div>
              <div>
                <p class="text-[20px] font-semibold leading-snug md:text-[22px]">{f.text}</p>
                <p class={`mt-3 font-mono text-caption ${sub}`}>{f.n}</p>
              </div>
            </div>
          </div>
        );
      })}
    </section>

    <!-- ═══ LE CONSTAT : SALLE DE BAIN ═══ -->
    <section class="bg-base" aria-labelledby="constat">
      <div class="px-6 pt-20 pb-10 md:px-14 md:pt-28">
        <div class="mx-auto max-w-[1240px]">
          <p class="font-mono text-eyebrow uppercase text-ember-deep">Le constat</p>
          <h2 id="constat" class="mt-4 max-w-[900px] text-[38px] leading-[1.02] tracking-[-0.04em] md:text-[64px]">Une salle de bain qui déborde, une peau qui sature</h2>
          <p class="mt-6 max-w-[640px] text-body-lg text-ink-2">Quand elles arrivent sur Mixt, la plupart ont déjà fait le tour du rayon. Nous avons compté les traitements essayés pour leur préoccupation principale : soins sans ordonnance, médicaments, séances en cabinet.</p>
        </div>
      </div>

      <div class="relative">
        <img src={`${IMG}produit-cremes-plateau-inox-01.webp`} alt="Plusieurs crèmes étalées sur un plateau en inox" class="block h-[420px] w-full object-cover md:h-[640px]" loading="lazy" width="1093" height="718" />
        <div class="px-6 md:absolute md:inset-0 md:px-14">
          <div class="mx-auto -mt-16 grid max-w-[1240px] gap-3 md:mt-0 md:h-full md:grid-cols-2 md:items-end md:gap-6 md:pb-14">
            <div class="rounded-[6px] bg-white p-7 shadow-[0_20px_40px_-24px_rgba(0,0,0,0.35)] md:max-w-[440px] md:p-9" data-rv>
              <p class="font-mono text-eyebrow uppercase text-ink-3">Rides</p>
              <p class="mt-3 text-[64px] font-bold leading-[0.9] tracking-[-0.05em] md:text-[88px]"><span data-count="4">4</span></p>
              <p class="mt-3 text-body-lg font-semibold">actifs ou soins déjà testés, en médiane</p>
              <p class="mt-2 text-body-sm text-ink-2">Près de la moitié en a essayé cinq ou plus : rétinol, vitamine C, acide hyaluronique, collagène, peptides…</p>
              <p class="mt-4 font-mono text-caption text-ink-3">47,5 % à 5 et plus · N = 80</p>
            </div>
            <div class="rounded-[6px] bg-deep p-7 text-white shadow-[0_20px_40px_-24px_rgba(0,0,0,0.35)] md:ml-auto md:max-w-[440px] md:p-9" data-rv>
              <p class="font-mono text-eyebrow uppercase text-white/60">Acné</p>
              <p class="mt-3 text-[64px] font-bold leading-[0.9] tracking-[-0.05em] md:text-[88px]">1 sur 3</p>
              <p class="mt-3 text-body-lg font-semibold">a déjà essayé trois traitements ou plus</p>
              <p class="mt-2 text-body-sm text-white/75">Près d'une sur cinq en est à cinq ou plus, antibiotiques et traitement oral de l'acné sévère compris.</p>
              <p class="mt-4 font-mono text-caption text-white/60">35,8 % à 3 et plus · 17,9 % à 5 et plus · N = 698</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Réactions -->
      <div class="px-6 py-20 md:px-14 md:py-28">
        <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-20">
          <div>
            <h3 class="text-[32px] font-bold leading-[1.05] tracking-[-0.035em] md:text-[44px]">À force, la peau proteste</h3>
